    def show_page(self, name):
        for page in self.pages.values():
            page.pack_forget()
        self.pages[name].pack(fill="both", expand=True)
        for key, btn in self.nav_buttons.items():
            active = key == name
            btn.configure(bg=ACCENT if active else PANEL, fg="white" if active else MUTED)
        if name == "Tasks":
            self.refresh_tasks()
        elif name == "Notes":
            self.refresh_notes()
        elif name == "Goals":
            self.refresh_goals()
        elif name == "Focus":
            self.refresh_sessions()
        elif name == "Overview":
            self.refresh_all()

    def _tick_clock(self):
        self.clock_label.configure(text=datetime.now().strftime("%A, %d %b  •  %I:%M:%S %p"))
        self.after(1000, self._tick_clock)

    def refresh_all(self):
        tasks = self.db.query("SELECT * FROM tasks")
        pending = sum(1 for t in tasks if t["status"] == "Pending")
        done = sum(1 for t in tasks if t["status"] == "Completed")
        overdue = sum(1 for t in tasks if t["status"] == "Pending" and t["due_date"] and t["due_date"] < date.today().isoformat())
        focus = self.db.query("SELECT COALESCE(SUM(duration_minutes),0) AS total FROM sessions")[0]["total"]
        for key, value in [("pending", pending), ("done", done), ("focus", focus), ("overdue", overdue)]:
            self.stat_values[key].configure(text=str(value))
        for child in self.today_list.winfo_children():
            child.destroy()
        today_tasks = self.db.query("""SELECT * FROM tasks WHERE status='Pending'
            ORDER BY CASE priority WHEN 'High' THEN 0 WHEN 'Medium' THEN 1 ELSE 2 END, due_date LIMIT 6""")
        if not today_tasks:
            self._label(self.today_list, "You're clear. Add a task to start building momentum.", 10, MUTED, wraplength=500, justify="left").pack(anchor="w", pady=12)
        for task in today_tasks:
            row = tk.Frame(self.today_list, bg=PANEL2)
            row.pack(fill="x", pady=4)
            color = RED if task["priority"] == "High" else ORANGE if task["priority"] == "Medium" else GREEN
            self._label(row, "●", 10, color, True).pack(side="left", padx=(10, 7), pady=10)
            self._label(row, task["title"], 10, TEXT, True).pack(side="left", fill="x", expand=True, pady=10)
            self._label(row, task["due_date"] or "No due date", 8, MUTED).pack(side="right", padx=10)
        for child in self.overview_goals.winfo_children():
            child.destroy()
        goals = self.db.query("SELECT * FROM goals ORDER BY id DESC LIMIT 4")
        if not goals:
            self._label(self.overview_goals, "No goals yet. Create one small target.", 9, MUTED, wraplength=250).pack(anchor="w", pady=8)
        for g in goals:
            self._label(self.overview_goals, g["title"], 9, TEXT, True).pack(anchor="w", pady=(5, 2))
            pct = min(100, int(g["progress"] / max(1, g["target"]) * 100))
            self._label(self.overview_goals, f'{g["progress"]}/{g["target"]}  •  {pct}%', 8, MUTED).pack(anchor="w")
        self.overview_timer.configure(text=self._format_time(self.timer_remaining))
        self.refresh_sessions()

    def refresh_tasks(self):
        if not hasattr(self, "task_tree"):
            return
        for item in self.task_tree.get_children():
            self.task_tree.delete(item)
        search = self.task_search.get().strip().lower()
        filt = self.task_filter.get()
        tasks = self.db.query("SELECT * FROM tasks ORDER BY CASE status WHEN 'Pending' THEN 0 ELSE 1 END, due_date, id DESC")
        for t in tasks:
            is_overdue = t["status"] == "Pending" and t["due_date"] and t["due_date"] < date.today().isoformat()
            if search and search not in t["title"].lower() and search not in t["category"].lower():
                continue
            if filt == "Pending" and t["status"] != "Pending": continue
            if filt == "Completed" and t["status"] != "Completed": continue
            if filt == "High priority" and t["priority"] != "High": continue
            if filt == "Overdue" and not is_overdue: continue
            tag = "Completed" if t["status"] == "Completed" else t["priority"]
            self.task_tree.insert("", "end", values=(t["id"], t["title"], t["category"], t["priority"],
                                                      t["due_date"] or "—", "OVERDUE" if is_overdue else t["status"]), tags=(tag,))

    def selected_task(self):
        sel = self.task_tree.selection()
        if not sel:
            messagebox.showinfo("Select a task", "Please select a task from the table first.")
            return None
        return self.task_tree.item(sel[0])["values"]

    def add_task(self):
        title = self.task_title.get().strip()
        due = self.task_due.get().strip()
        if not title:
            messagebox.showwarning("Missing title", "Enter a task title before adding it.")
            return
        if due:
            try: datetime.strptime(due, "%Y-%m-%d")
            except ValueError:
                messagebox.showwarning("Invalid date", "Use YYYY-MM-DD format, for example 2026-10-25.")
                return
        try:
            self.db.execute("INSERT INTO tasks(title,category,priority,due_date,status,created_at) VALUES(?,?,?,?,?,?)",
                            (title, self.task_category.get(), self.task_priority.get(), due or None, "Pending", now_stamp()))
            self.task_title.set("")
            self.refresh_tasks()
            self.refresh_all()
        except sqlite3.Error as e:
            messagebox.showerror("Database error", f"Could not save task.\n\n{e}")

    def complete_task(self):
        row = self.selected_task()
        if not row: return
        try:
            self.db.execute("UPDATE tasks SET status=? WHERE id=?", ("Completed", row[0]))
            self.refresh_tasks(); self.refresh_all()
        except sqlite3.Error as e: messagebox.showerror("Database error", str(e))

    def edit_task(self):
        row = self.selected_task()
        if not row: return
        task_id = row[0]
        record = self.db.query("SELECT * FROM tasks WHERE id=?", (task_id,))
        if not record: return
        r = record[0]
        title = simpledialog.askstring("Edit task", "Task title:", initialvalue=r["title"], parent=self)
        if title is None: return
        title = title.strip()
        if not title:
            messagebox.showwarning("Invalid title", "Task title cannot be empty."); return
        due = simpledialog.askstring("Edit due date", "Due date (YYYY-MM-DD) or leave blank:", initialvalue=r["due_date"] or "", parent=self)
        if due is None: return
        due = due.strip()
        if due:
            try: datetime.strptime(due, "%Y-%m-%d")
            except ValueError:
                messagebox.showwarning("Invalid date", "Use YYYY-MM-DD format."); return
        self.db.execute("UPDATE tasks SET title=?, due_date=? WHERE id=?", (title, due or None, task_id))
        self.refresh_tasks(); self.refresh_all()

    def delete_task(self):
        row = self.selected_task()
        if not row: return
        if messagebox.askyesno("Delete task", f'Delete "{row[1]}" permanently?'):
            self.db.execute("DELETE FROM tasks WHERE id=?", (row[0],))
            self.refresh_tasks(); self.refresh_all()

    def export_tasks(self):
        path = filedialog.asksaveasfilename(parent=self, title="Export tasks", defaultextension=".csv",
                                            filetypes=[("CSV files", "*.csv")], initialfile="focusforge_tasks.csv")
        if not path: return
        try:
            tasks = self.db.query("SELECT id,title,category,priority,due_date,status,created_at FROM tasks ORDER BY id")
            with open(path, "w", newline="", encoding="utf-8-sig") as f:
                writer = csv.writer(f)
                writer.writerow(["ID", "Title", "Category", "Priority", "Due Date", "Status", "Created At"])
                writer.writerows([tuple(t) for t in tasks])
            messagebox.showinfo("Export complete", f"Exported {len(tasks)} tasks to:\n{path}")
        except OSError as e: messagebox.showerror("Export failed", str(e))

    def _format_time(self, seconds):
        seconds = max(0, int(seconds))
        return f"{seconds // 60:02d}:{seconds % 60:02d}"

    def set_timer_mode(self, mode):
        self.pause_timer()
        self.timer_mode = mode
        self.timer_remaining = {"Focus": 25 * 60, "Short break": 5 * 60, "Long break": 15 * 60}[mode]
        self._update_timer_ui()
        self.timer_status.configure(text=f"{mode.upper()} • READY")

    def start_timer(self):
        if self.timer_running: return
        if not self.timer_task.get().strip():
            messagebox.showwarning("Name your session", "Enter a task name for this focus session.")
            return
        self.timer_running = True
        self.timer_status.configure(text=f"{self.timer_mode.upper()} • IN PROGRESS", fg=GREEN)
        self._timer_tick()

    def _timer_tick(self):
        if not self.timer_running: return
        if self.timer_remaining <= 0:
            self.timer_running = False
            if self.timer_after_id:
                self.after_cancel(self.timer_after_id); self.timer_after_id = None
            if self.timer_mode == "Focus":
                self.db.execute("INSERT INTO sessions(task_title,duration_minutes,completed_at) VALUES(?,?,?)",
                                (self.timer_task.get().strip(), 25, now_stamp()))
            self.timer_status.configure(text="SESSION COMPLETE • NICE WORK", fg=GREEN)
            self.refresh_all()
            messagebox.showinfo("Timer complete", f"{self.timer_mode} session complete. Take a breath!")
            self._update_timer_ui()
            return
        self._update_timer_ui()
        self.timer_remaining -= 1
        self.timer_after_id = self.after(1000, self._timer_tick)

    def pause_timer(self):
        self.timer_running = False
        if self.timer_after_id:
            try: self.after_cancel(self.timer_after_id)
            except tk.TclError: pass
            self.timer_after_id = None
        if hasattr(self, "timer_status"):
            self.timer_status.configure(text="PAUSED" if self.timer_remaining < {"Focus":1500,"Short break":300,"Long break":900}[self.timer_mode] else "READY WHEN YOU ARE",
                                        fg=MUTED)
        self._update_timer_ui()

    def reset_timer(self):
        self.pause_timer()
        self.timer_remaining = {"Focus": 25 * 60, "Short break": 5 * 60, "Long break": 15 * 60}[self.timer_mode]
        self._update_timer_ui()

    def _update_timer_ui(self):
        value = self._format_time(self.timer_remaining)
        if hasattr(self, "timer_display"): self.timer_display.configure(text=value)
        if hasattr(self, "overview_timer"): self.overview_timer.configure(text=value)
        if hasattr(self, "timer_canvas"):
            total = {"Focus": 1500, "Short break": 300, "Long break": 900}[self.timer_mode]
            width = 300 * (self.timer_remaining / total)
            self.timer_canvas.coords("progress", 0, 0, width, 14)

    def refresh_sessions(self):
        if not hasattr(self, "session_list"): return
        for child in self.session_list.winfo_children(): child.destroy()
        sessions = self.db.query("SELECT * FROM sessions ORDER BY id DESC LIMIT 5")
        if not sessions:
            self._label(self.session_list, "No completed focus sessions yet.", 9, MUTED, wraplength=240).pack(anchor="w", pady=5)
        for s in sessions:
            self._label(self.session_list, s["task_title"], 9, TEXT, True, wraplength=240, justify="left").pack(anchor="w", pady=(5, 1))
            self._label(self.session_list, f'{s["duration_minutes"]} min • {s["completed_at"][:16]}', 8, MUTED).pack(anchor="w", pady=(0, 3))

    def refresh_notes(self):
        self.notes_cache = self.db.query("SELECT * FROM notes ORDER BY updated_at DESC")
        self.notes_list.delete(0, "end")
        for n in self.notes_cache:
            self.notes_list.insert("end", n["title"])
        if self.current_note_id and hasattr(self, "notes_cache"):
            for i, n in enumerate(self.notes_cache):
                if n["id"] == self.current_note_id:
                    self.notes_list.selection_set(i); break

    def load_note(self, _event=None):
        sel = self.notes_list.curselection()
        if not sel: return
        n = self.notes_cache[sel[0]]
        self.current_note_id = n["id"]
        self.note_title.set(n["title"])
        self.note_body.delete("1.0", "end")
        self.note_body.insert("1.0", n["body"])

    def new_note(self):
        self.current_note_id = None
        self.note_title.set("")
        self.note_body.delete("1.0", "end")
        self.note_title_entry_focus()

    def note_title_entry_focus(self):
        # Focus the note body for quick writing; title can be entered above.
        self.note_body.focus_set()

    def save_note(self):
        title = self.note_title.get().strip()
        body = self.note_body.get("1.0", "end-1c").strip()
        if not title:
            messagebox.showwarning("Title required", "Give your note a title before saving."); return
        if not body:
            messagebox.showwarning("Empty note", "Write a little content before saving."); return
        try:
            if self.current_note_id:
                self.db.execute("UPDATE notes SET title=?,body=?,updated_at=? WHERE id=?",
                                (title, body, now_stamp(), self.current_note_id))
            else:
                self.current_note_id = self.db.execute("INSERT INTO notes(title,body,updated_at) VALUES(?,?,?)",
                                                       (title, body, now_stamp()))
            self.refresh_notes()
            messagebox.showinfo("Saved", "Your note has been saved locally.")
        except sqlite3.Error as e: messagebox.showerror("Save failed", str(e))

    def delete_note(self):
        if not self.current_note_id:
            messagebox.showinfo("Select a note", "Select a saved note to delete."); return
        if messagebox.askyesno("Delete note", "Delete this note permanently?"):
            self.db.execute("DELETE FROM notes WHERE id=?", (self.current_note_id,))
            self.current_note_id = None
            self.note_title.set("")
            self.note_body.delete("1.0", "end")
            self.refresh_notes()

    def add_goal(self):
        title = self.goal_title.get().strip()
        try: target = int(self.goal_target.get())
        except ValueError:
            messagebox.showwarning("Invalid target", "Target must be a whole number, such as 10."); return
        if not title:
            messagebox.showwarning("Goal required", "Enter a name for your goal."); return
        if target < 1 or target > 100000:
            messagebox.showwarning("Invalid target", "Target must be between 1 and 100000."); return
        try:
            self.db.execute("INSERT INTO goals(title,target,progress,created_at) VALUES(?,?,0,?)",
                            (title, target, now_stamp()))
            self.goal_title.set("")
            self.refresh_goals(); self.refresh_all()
        except sqlite3.Error as e: messagebox.showerror("Save failed", str(e))

    def refresh_goals(self):
        for child in self.goals_container.winfo_children(): child.destroy()
        goals = self.db.query("SELECT * FROM goals ORDER BY id DESC")
        if not goals:
            self._label(self.goals_container, "No goals yet — create your first measurable target above.", 11, MUTED).pack(anchor="w", pady=18)
        for g in goals:
            card = tk.Frame(self.goals_container, bg=PANEL, highlightbackground=BORDER, highlightthickness=1)
            card.pack(fill="x", pady=6)
            top = tk.Frame(card, bg=PANEL)
            top.pack(fill="x", padx=15, pady=(12, 7))
            self._label(top, g["title"], 12, TEXT, True).pack(side="left")
            pct = min(100, int(g["progress"] / max(1, g["target"]) * 100))
            self._label(top, f'{g["progress"]}/{g["target"]}  •  {pct}%', 10, CYAN, True).pack(side="right")
            canvas = tk.Canvas(card, height=8, bg=PANEL2, highlightthickness=0)
            canvas.pack(fill="x", padx=15, pady=(0, 10))
            canvas.update_idletasks()
            width = max(1, canvas.winfo_width())
            canvas.create_rectangle(0, 0, width * pct / 100, 8, fill=GREEN if pct == 100 else ACCENT, outline="")
            controls = tk.Frame(card, bg=PANEL)
            controls.pack(fill="x", padx=15, pady=(0, 12))
            self._button(controls, "+1 progress", lambda gid=g["id"]: self.bump_goal(gid, 1), color="#247c61").pack(side="left")
            self._button(controls, "−1", lambda gid=g["id"]: self.bump_goal(gid, -1), color=PANEL2, fg=TEXT).pack(side="left", padx=6)
            self._button(controls, "Delete", lambda gid=g["id"]: self.remove_goal(gid), color="#85384a").pack(side="right")

    def bump_goal(self, goal_id, delta):
        g = self.db.query("SELECT * FROM goals WHERE id=?", (goal_id,))
        if not g: return
        progress = max(0, min(g[0]["target"], g[0]["progress"] + delta))
        self.db.execute("UPDATE goals SET progress=? WHERE id=?", (progress, goal_id))
        self.refresh_goals(); self.refresh_all()

    def remove_goal(self, goal_id):
        if messagebox.askyesno("Delete goal", "Delete this goal and its progress?"):
            self.db.execute("DELETE FROM goals WHERE id=?", (goal_id,))
            self.refresh_goals(); self.refresh_all()

    def on_close(self):
        if self.timer_running:
            if not messagebox.askyesno("Timer running", "The focus timer is running. Close the app anyway?"):
                return
        try:
            if self.timer_after_id: self.after_cancel(self.timer_after_id)
            self.db.close()
        except Exception:
            pass
        self.destroy()


def main():
    try:
        app = FocusForge()
        app.mainloop()
    except sqlite3.Error as exc:
        messagebox.showerror("Database startup error", f"FocusForge could not open its local database.\n\n{exc}\n\nTry running it from a folder where you have write permission.")
    except tk.TclError as exc:
        print("Tkinter GUI error:", exc, file=sys.stderr)
        print("Make sure Python was installed with Tcl/Tk support.", file=sys.stderr)
        raise


if __name__ == "__main__":
    main()
