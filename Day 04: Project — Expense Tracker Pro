    def refresh_transactions(self):
        if not hasattr(self, "txn_tree") or not self.txn_tree.winfo_exists():
            return
        for item in self.txn_tree.get_children():
            self.txn_tree.delete(item)
        for r in self.store.list(self.search_var.get(), self.month_var.get(), self.type_var.get()):
            self.txn_tree.insert("", "end", iid=str(r["id"]), values=(
                r["id"], r["txn_date"], r["title"], r["category"], r["txn_type"],
                money(r["amount"]), r["payment_method"], r["notes"]))

    def on_select(self, _event=None):
        sel = self.txn_tree.selection()
        self.selected_id = int(sel[0]) if sel else None
        if self.selected_id:
            self.selected_label.config(text=f"Selected transaction ID: {self.selected_id}")

    def edit_selected(self):
        if not self.selected_id:
            messagebox.showwarning("Select transaction", "Select a transaction first."); return
        row = self.store.get(self.selected_id)
        if row: self.show_form(row)

    def delete_selected(self):
        if not self.selected_id:
            messagebox.showwarning("Select transaction", "Select a transaction first."); return
        row = self.store.get(self.selected_id)
        if row and messagebox.askyesno("Confirm delete", f"Delete '{row['title']}' ({money(row['amount'])})?"):
            self.store.delete(self.selected_id)
            self.selected_id = None
            self.show_transactions()
            messagebox.showinfo("Deleted", "Transaction deleted.")

