    def save_transaction(self, txn_id=None):
        txn_date, txn_type = self.form_date.get().strip(), self.form_type.get()
        title, category = self.form_title.get().strip(), self.form_category.get()
        amount_text, payment = self.form_amount.get().strip(), self.form_payment.get()
        notes = self.form_notes.get("1.0", "end").strip()
        try: datetime.strptime(txn_date, "%Y-%m-%d")
        except ValueError:
            messagebox.showerror("Invalid date", "Date must use YYYY-MM-DD format."); return
        if not title:
            messagebox.showwarning("Required", "Please enter a description."); return
        try:
            amount = float(amount_text)
            if amount <= 0: raise ValueError
        except ValueError:
            messagebox.showerror("Invalid amount", "Enter an amount greater than zero."); return
        data = (txn_date, txn_type, category, title, amount, payment, notes)
        try:
            if txn_id:
                self.store.update(txn_id, data); msg = "Transaction updated successfully."
            else:
                self.store.add(data); msg = "Transaction saved successfully."
        except sqlite3.Error as exc:
            messagebox.showerror("Database error", str(exc)); return
        messagebox.showinfo("Saved", msg)
        self.show_dashboard()

