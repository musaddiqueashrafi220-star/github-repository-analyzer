    def draw_chart(self, parent, income, expenses):
        canvas = tk.Canvas(parent, bg=PANEL, highlightthickness=0, height=250)
        canvas.pack(fill="both", expand=True, padx=18, pady=12)
        def draw(_event=None):
            canvas.delete("all")
            w, h = max(canvas.winfo_width(), 400), max(canvas.winfo_height(), 220)
            left, right, top, bottom = 45, w-25, 20, h-45
            canvas.create_line(left, bottom, right, bottom, fill=BORDER, width=2)
            maximum = max(float(income), float(expenses), 1)
            for i in range(1, 5):
                y = bottom-(bottom-top)*i/4
                canvas.create_line(left, y, right, y, fill="#243953", dash=(3,4))
            bar_w = min(100, (right-left)/5)
            for center, value, color, title in [
                (left+(right-left)*.34, income, GREEN, "Income"),
                (left+(right-left)*.72, expenses, RED, "Expenses")]:
                bh = (bottom-top)*float(value)/maximum
                canvas.create_rectangle(center-bar_w/2, bottom-bh, center+bar_w/2, bottom, fill=color, outline="")
                canvas.create_text(center, max(top+10, bottom-bh-15), text=money(value),
                                  fill=TEXT, font=("Segoe UI", 10, "bold"))
                canvas.create_text(center, bottom+22, text=title, fill=MUTED,
                                   font=("Segoe UI", 10, "bold"))
        canvas.bind("<Configure>", draw)
        canvas.after(100, draw)

    def draw_categories(self, parent, month):
        rows = self.store.category_totals(month)
        total = sum(float(r["total"]) for r in rows)
        if not rows:
            self.label(parent, "No expenses this month yet.", 10, MUTED).pack(anchor="w", padx=18, pady=18)
            return
        for r in rows[:7]:
            line = tk.Frame(parent, bg=PANEL)
            line.pack(fill="x", padx=18, pady=7)
            self.label(line, r["category"], 9, TEXT, True).pack(side="left")
            self.label(line, money(r["total"]), 9, MUTED).pack(side="right")
            bar = tk.Frame(parent, bg="#263b56", height=6)
            bar.pack(fill="x", padx=18, pady=(0, 4)); bar.pack_propagate(False)
            tk.Frame(bar, bg=BLUE, width=max(1, int(240*float(r["total"])/total))).pack(side="left", fill="y")

