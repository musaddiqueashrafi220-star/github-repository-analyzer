        panel.pack(fill="both",expand=True)
        self.label(panel,"Export your financial records",16,TEXT,True).pack(anchor="w",padx=28,pady=(28,8))
        self.label(panel,"CSV files open in Excel, Google Sheets, and LibreOffice.",10,MUTED).pack(anchor="w",padx=28,pady=(0,25))
        self.button(panel,"Export All Transactions to CSV",self.export_csv,GREEN).pack(anchor="w",padx=28,pady=8)
        self.button(panel,"Export Current Month to CSV",lambda:self.export_csv(month),BLUE).pack(anchor="w",padx=28,pady=8)
        self.label(panel,"Expense breakdown by category",12,TEXT,True).pack(anchor="w",padx=28,pady=(25,8))
        rows = self.store.category_totals()
        if not rows: self.label(panel,"No expense records available yet.",10,MUTED).pack(anchor="w",padx=28,pady=5)
        for r in rows:
            line=tk.Frame(panel,bg=PANEL); line.pack(fill="x",padx=28,pady=5)
            self.label(line,r["category"],10,TEXT).pack(side="left")
            self.label(line,money(r["total"]),10,RED,True).pack(side="right")

    def export_csv(self, month=None):
        rows = self.store.list(month=month or "All months")
        if not rows:
            messagebox.showinfo("No data","There are no transactions to export."); return
        name = f"expense_report_{month}.csv" if month else "expense_report_all.csv"
        path = filedialog.asksaveasfilename(title="Export transactions",defaultextension=".csv",
                                            initialfile=name,filetypes=[("CSV files","*.csv")])
        if not path: return
        try:
            with open(path,"w",newline="",encoding="utf-8-sig") as f:
                writer=csv.writer(f)
                writer.writerow(["Transaction ID","Date","Type","Category","Description","Amount","Payment Method","Notes"])
                for r in rows:
                    writer.writerow([r["id"],r["txn_date"],r["txn_type"],r["category"],r["title"],
                                     r["amount"],r["payment_method"],r["notes"]])
            messagebox.showinfo("Export complete",f"CSV saved successfully:\n{path}")
        except OSError as exc: messagebox.showerror("Export failed",str(exc))

    def on_close(self):
        self.store.close()
        self.destroy()


if __name__ == "__main__":
    app = ExpenseTracker()
    app.mainloop()
