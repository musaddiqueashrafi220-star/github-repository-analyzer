def money(value):
    return f"₹{float(value or 0):,.2f}"


class Store:
    def __init__(self):
        self.conn = sqlite3.connect(DB_FILE)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                txn_date TEXT NOT NULL,
                txn_type TEXT NOT NULL CHECK(txn_type IN ('Income','Expense')),
                category TEXT NOT NULL,
                title TEXT NOT NULL,
                amount REAL NOT NULL CHECK(amount > 0),
                payment_method TEXT NOT NULL DEFAULT 'Cash',
                notes TEXT DEFAULT '',
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        self.conn.commit()

    def add(self, data):
        self.conn.execute("""INSERT INTO transactions
            (txn_date,txn_type,category,title,amount,payment_method,notes)
            VALUES (?,?,?,?,?,?,?)""", data)
        self.conn.commit()

    def update(self, txn_id, data):
        self.conn.execute("""UPDATE transactions SET txn_date=?,txn_type=?,category=?,
            title=?,amount=?,payment_method=?,notes=? WHERE id=?""", (*data, txn_id))
        self.conn.commit()

    def delete(self, txn_id):
        self.conn.execute("DELETE FROM transactions WHERE id=?", (txn_id,))
        self.conn.commit()

    def get(self, txn_id):
        return self.conn.execute("SELECT * FROM transactions WHERE id=?", (txn_id,)).fetchone()

    def list(self, search="", month="All months", txn_type="All types"):
        query, args = "SELECT * FROM transactions WHERE 1=1", []
        if search.strip():
            term = f"%{search.strip()}%"
            query += " AND (title LIKE ? OR category LIKE ? OR notes LIKE ? OR payment_method LIKE ?)"
            args.extend([term] * 4)
        if month != "All months":
            query += " AND substr(txn_date,1,7)=?"
            args.append(month)
        if txn_type != "All types":
            query += " AND txn_type=?"
            args.append(txn_type)
        query += " ORDER BY txn_date DESC,id DESC"
        return self.conn.execute(query, args).fetchall()

    def totals(self, month=None):
        where, args = ("", []) if not month else ("WHERE substr(txn_date,1,7)=?", [month])
        row = self.conn.execute(f"""SELECT
            COALESCE(SUM(CASE WHEN txn_type='Income' THEN amount ELSE 0 END),0) income,
            COALESCE(SUM(CASE WHEN txn_type='Expense' THEN amount ELSE 0 END),0) expenses,
            COUNT(*) count FROM transactions {where}""", args).fetchone()
        return dict(row)

    def category_totals(self, month=None):
        where, args = "WHERE txn_type='Expense'", []
        if month:
            where += " AND substr(txn_date,1,7)=?"
            args.append(month)
        return self.conn.execute(f"""SELECT category,SUM(amount) total FROM transactions
            {where} GROUP BY category ORDER BY total DESC""", args).fetchall()

    def months(self):
        rows = self.conn.execute("""SELECT DISTINCT substr(txn_date,1,7) month
            FROM transactions ORDER BY month DESC""").fetchall()
        return ["All months"] + [r["month"] for r in rows]

    def close(self):
        self.conn.close()


