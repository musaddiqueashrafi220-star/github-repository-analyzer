    # ========================================================
    # GENDER GRAPH
    # ========================================================

    def draw_gender_graph(self, boys, girls):

        canvas = self.gender_canvas

        canvas.delete("all")

        canvas.update_idletasks()

        width = max(canvas.winfo_width(), 300)
        height = max(canvas.winfo_height(), 250)

        total = boys + girls

        if total == 0:

            canvas.create_text(
                width // 2,
                height // 2,
                text="No student data available",
                fill=self.GRAY,
                font=("Segoe UI", 11)
            )

            return

        max_value = max(boys, girls, 1)

        base_y = height - 60
        top_y = 45

        chart_height = base_y - top_y

        bar_width = 90

        x1 = width // 2 - 100
        x2 = width // 2 + 100

        # Axis
        canvas.create_line(
            60,
            base_y,
            width - 40,
            base_y,
            fill="#CBD5E1",
            width=1
        )

        # Boys
        boy_height = int(
            chart_height * boys / max_value
        )

        canvas.create_rectangle(
            x1 - bar_width // 2,
            base_y - boy_height,
            x1 + bar_width // 2,
            base_y,
            fill="#2563EB",
            outline=""
        )

        canvas.create_text(
            x1,
            base_y - boy_height - 15,
            text=str(boys),
            fill=self.TEXT,
            font=("Segoe UI Black", 14)
        )

        canvas.create_text(
            x1,
            base_y + 22,
            text="BOYS",
            fill=self.GRAY,
            font=("Segoe UI Semibold", 9)
        )

        # Girls
        girl_height = int(
            chart_height * girls / max_value
        )

        canvas.create_rectangle(
            x2 - bar_width // 2,
            base_y - girl_height,
            x2 + bar_width // 2,
            base_y,
            fill="#DB2777",
            outline=""
        )

        canvas.create_text(
            x2,
            base_y - girl_height - 15,
            text=str(girls),
            fill=self.TEXT,
            font=("Segoe UI Black", 14)
        )

        canvas.create_text(
            x2,
            base_y + 22,
            text="GIRLS",
            fill=self.GRAY,
            font=("Segoe UI Semibold", 9)
        )

        # Percentage
        boy_percent = boys / total * 100
        girl_percent = girls / total * 100

        canvas.create_text(
            x1,
            base_y + 45,
            text=f"{boy_percent:.1f}%",
            fill="#2563EB",
            font=("Segoe UI Semibold", 9)
        )

        canvas.create_text(
            x2,
            base_y + 45,
            text=f"{girl_percent:.1f}%",
            fill="#DB2777",
            font=("Segoe UI Semibold", 9)
        )

    # ========================================================
    # CLASS GRAPH
    # ========================================================

    def draw_class_graph(self, class_data):

        canvas = self.class_canvas

        canvas.delete("all")

        canvas.update_idletasks()

        width = max(canvas.winfo_width(), 350)
        height = max(canvas.winfo_height(), 250)

        if not class_data:

            canvas.create_text(
                width // 2,
                height // 2,
                text="No student data available",
                fill=self.GRAY,
                font=("Segoe UI", 11)
            )

            return

        order = [
            "5th",
            "6th",
            "7th",
            "8th",
            "9th",
            "10th",
            "11th",
            "12th"
        ]

        data_dict = dict(class_data)

        ordered = []

        for cls in order:

            if cls in data_dict:
                ordered.append(
                    (cls, data_dict[cls])
                )

        # Other classes
        for cls, count in class_data:

            if cls not in order:
                ordered.append(
                    (cls, count)
                )

        if not ordered:
            return

        max_value = max(
            count for _, count in ordered
        )

        left = 60
        right = width - 25
        top = 35
        bottom = height - 40

        chart_width = right - left
        chart_height = bottom - top

        count = len(ordered)

        bar_width = max(
            25,
            int(chart_width / count * 0.55)
        )

        gap = chart_width / count

        for i, (class_name, number) in enumerate(ordered):

            x_center = left + gap * i + gap / 2

            bar_height = int(
                chart_height * number / max_value
            )

            x1 = x_center - bar_width / 2
            x2 = x_center + bar_width / 2

            y1 = bottom - bar_height
            y2 = bottom

            canvas.create_rectangle(
                x1,
                y1,
                x2,
                y2,
                fill=self.BLUE,
                outline=""
            )

            canvas.create_text(
                x_center,
                y1 - 12,
                text=str(number),
                fill=self.TEXT,
                font=("Segoe UI Semibold", 9)
            )

            canvas.create_text(
                x_center,
                bottom + 18,
                text=class_name,
                fill=self.GRAY,
                font=("Segoe UI Semibold", 8)
            )

        canvas.create_line(
            left,
            bottom,
            right,
            bottom,
            fill="#CBD5E1"
        )

