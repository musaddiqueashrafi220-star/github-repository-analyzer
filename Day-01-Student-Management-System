class Database:

    def __init__(self):
        self.db_path = DB_PATH
        self.create_database()

    def connect(self):
        return sqlite3.connect(self.db_path)

    def create_database(self):

        conn = self.connect()
        cur = conn.cursor()

        cur.execute("""
            CREATE TABLE IF NOT EXISTS students (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                admission_id TEXT UNIQUE,
                student_name TEXT NOT NULL,
                dob TEXT,
                gender TEXT,
                student_class TEXT,
                division TEXT,
                roll_no TEXT,
                phone TEXT,
                email TEXT,
                address TEXT,
                guardian_name TEXT,
                admission_date TEXT,
                photo_path TEXT,
                created_at TEXT
            )
        """)

        conn.commit()

        # ----------------------------------------------------
        # Database migration for older versions
        # ----------------------------------------------------

        cur.execute("PRAGMA table_info(students)")
        columns = [row[1] for row in cur.fetchall()]

        required_columns = {
            "dob": "TEXT",
            "gender": "TEXT",
            "student_class": "TEXT",
            "division": "TEXT",
            "roll_no": "TEXT",
            "phone": "TEXT",
            "email": "TEXT",
            "address": "TEXT",
            "guardian_name": "TEXT",
            "admission_date": "TEXT",
            "photo_path": "TEXT",
            "created_at": "TEXT"
        }

        for column, data_type in required_columns.items():

            if column not in columns:

                try:
                    cur.execute(
                        f"ALTER TABLE students ADD COLUMN {column} {data_type}"
                    )
                except sqlite3.OperationalError:
                    pass

        conn.commit()
        conn.close()

    # ========================================================
    # ADD
    # ========================================================

    def add_student(self, data):

        conn = self.connect()
        cur = conn.cursor()

        try:

            cur.execute("""
                INSERT INTO students (
                    admission_id,
                    student_name,
                    dob,
                    gender,
                    student_class,
                    division,
                    roll_no,
                    phone,
                    email,
                    address,
                    guardian_name,
                    admission_date,
                    photo_path,
                    created_at
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                data["admission_id"],
                data["student_name"],
                data["dob"],
                data["gender"],
                data["student_class"],
                data["division"],
                data["roll_no"],
                data["phone"],
                data["email"],
                data["address"],
                data["guardian_name"],
                data["admission_date"],
                data["photo_path"],
                datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            ))

            conn.commit()
            return True, "Student added successfully."

        except sqlite3.IntegrityError:

            return False, "Admission ID already exists."

        except Exception as e:

            return False, str(e)

        finally:

            conn.close()

    # ========================================================
    # UPDATE
    # ========================================================

    def update_student(self, admission_id, data):

        conn = self.connect()
        cur = conn.cursor()

        try:

            cur.execute("""
                UPDATE students
                SET
                    student_name=?,
                    dob=?,
                    gender=?,
                    student_class=?,
                    division=?,
                    roll_no=?,
                    phone=?,
                    email=?,
                    address=?,
                    guardian_name=?,
                    admission_date=?,
                    photo_path=?
                WHERE admission_id=?
            """, (
                data["student_name"],
                data["dob"],
                data["gender"],
                data["student_class"],
                data["division"],
                data["roll_no"],
                data["phone"],
                data["email"],
                data["address"],
                data["guardian_name"],
                data["admission_date"],
                data["photo_path"],
                admission_id
            ))

            conn.commit()

            if cur.rowcount > 0:
                return True, "Student updated successfully."

            return False, "Student not found."

        except Exception as e:

            return False, str(e)

        finally:

            conn.close()

    # ========================================================
    # DELETE
    # ========================================================

    def delete_student(self, admission_id):

        conn = self.connect()
        cur = conn.cursor()

        try:

            cur.execute(
                "SELECT photo_path FROM students WHERE admission_id=?",
                (admission_id,)
            )

            row = cur.fetchone()

            cur.execute(
                "DELETE FROM students WHERE admission_id=?",
                (admission_id,)
            )

            conn.commit()

            if cur.rowcount > 0:

                if row and row[0]:
                    try:
                        if os.path.exists(row[0]):
                            os.remove(row[0])
                    except:
                        pass

                return True, "Student deleted successfully."

            return False, "Student not found."

        except Exception as e:

            return False, str(e)

        finally:

            conn.close()

    # ========================================================
    # GET STUDENT
    # ========================================================

    def get_student(self, admission_id):

        conn = self.connect()
        cur = conn.cursor()

        cur.execute("""
            SELECT
                admission_id,
                student_name,
                dob,
                gender,
                student_class,
                division,
                roll_no,
                phone,
                email,
                address,
                guardian_name,
                admission_date,
                photo_path,
                id
            FROM students
            WHERE admission_id=?
        """, (admission_id,))

        row = cur.fetchone()

        conn.close()

        return row

    # ========================================================
    # GET ALL
    # ========================================================

    def get_all(self):

        conn = self.connect()
        cur = conn.cursor()

        cur.execute("""
            SELECT
                id,
                admission_id,
                student_name,
                gender,
                student_class,
                division,
                roll_no,
                phone,
                email,
                guardian_name,
                admission_date,
                photo_path
            FROM students
            ORDER BY id DESC
        """)

        rows = cur.fetchall()

        conn.close()

        return rows

    # ========================================================
    # SEARCH
    # ========================================================

    def search(self, keyword):

        conn = self.connect()
        cur = conn.cursor()

        value = f"%{keyword}%"

        cur.execute("""
            SELECT
                id,
                admission_id,
                student_name,
                gender,
                student_class,
                division,
                roll_no,
                phone,
                email,
                guardian_name,
                admission_date,
                photo_path
            FROM students
            WHERE
                admission_id LIKE ?
                OR student_name LIKE ?
                OR phone LIKE ?
                OR student_class LIKE ?
                OR roll_no LIKE ?
            ORDER BY id DESC
        """, (
            value,
            value,
            value,
            value,
            value
        ))

        rows = cur.fetchall()

        conn.close()

        return rows

    # ========================================================
    # STATISTICS
    # ========================================================

    def statistics(self):

        conn = self.connect()
        cur = conn.cursor()

        cur.execute("SELECT COUNT(*) FROM students")
        total = cur.fetchone()[0]

        cur.execute("""
            SELECT COUNT(*)
            FROM students
            WHERE LOWER(gender)='male'
        """)
        boys = cur.fetchone()[0]

        cur.execute("""
            SELECT COUNT(*)
            FROM students
            WHERE LOWER(gender)='female'
        """)
        girls = cur.fetchone()[0]

        cur.execute("""
            SELECT COUNT(DISTINCT student_class)
            FROM students
            WHERE student_class IS NOT NULL
            AND student_class != ''
        """)
        classes = cur.fetchone()[0]

        cur.execute("""
            SELECT student_class, COUNT(*)
            FROM students
            WHERE student_class IS NOT NULL
            AND student_class != ''
            GROUP BY student_class
        """)

        class_data = cur.fetchall()

        conn.close()

        return total, boys, girls, classes, class_data


