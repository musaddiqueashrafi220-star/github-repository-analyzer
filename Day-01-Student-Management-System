            bg="white",
            highlightbackground=self.BORDER,
            highlightthickness=1
        )

        search_frame.pack(
            fill="x",
            padx=30,
            pady=15
        )

        keyword = tk.StringVar()

        entry = tk.Entry(
            search_frame,
            textvariable=keyword,
            font=("Segoe UI", 11),
            relief="solid",
            bd=1
        )

        entry.pack(
            side="left",
            fill="x",
            expand=True,
            padx=15,
            pady=12,
            ipady=6
        )

        table_frame = tk.Frame(
            window,
            bg="white",
            highlightbackground=self.BORDER,
            highlightthickness=1
        )

        table_frame.pack(
            fill="both",
            expand=True,
            padx=30,
            pady=(0, 25)
        )

        columns = (
            "ID",
            "Admission ID",
            "Name",
            "Gender",
            "Class",
            "Division",
            "Roll No",
            "Phone"
        )

        tree = ttk.Treeview(
            table_frame,
            columns=columns,
            show="headings"
        )

        widths = [
            60,
            130,
            220,
            90,
            80,
            90,
            90,
            140
        ]

        for col, width in zip(columns, widths):

            tree.heading(
                col,
                text=col
            )

            tree.column(
                col,
                width=width,
                anchor="center"
            )

        scroll = ttk.Scrollbar(
            table_frame,
            orient="vertical",
            command=tree.yview
        )

        tree.configure(
            yscrollcommand=scroll.set
        )

        tree.pack(
            side="left",
            fill="both",
            expand=True
        )

        scroll.pack(
            side="right",
            fill="y"
        )

        def perform_search():

            for item in tree.get_children():
                tree.delete(item)

            rows = self.db.search(
                keyword.get().strip()
            )

            for row in rows:

                tree.insert(
                    "",
                    "end",
                    values=(
                        row[0],
                        row[1],
                        row[2],
                        row[3],
                        row[4],
                        row[5],
                        row[6],
                        row[7]
                    )
                )

        tk.Button(
            search_frame,
            text="Search",
            command=perform_search,
            bg=self.BLUE,
            fg="white",
            activebackground=self.BLUE2,
            activeforeground="white",
            bd=0,
            font=("Segoe UI Semibold", 10),
            cursor="hand2",
            padx=30,
            pady=11
        ).pack(
            side="right",
            padx=15
        )

        entry.bind(
            "<Return>",
            lambda e: perform_search()
        )

        perform_search()

