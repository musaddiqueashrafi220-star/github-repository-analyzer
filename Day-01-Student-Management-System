            window,
            bg=self.LIGHT
        )

        bottom.pack(
            fill="x",
            padx=30,
            pady=(0, 20)
        )

        tk.Button(
            bottom,
            text="Save Student",
            command=save_student,
            bg=self.GREEN,
            fg="white",
            activebackground="#15803D",
            activeforeground="white",
