            padx=60,
            pady=20,
            ipady=8
        )

        def delete():

            value = admission.get().strip()

            if not value:

                messagebox.showwarning(
                    "Required",
                    "Enter Admission ID.",
                    parent=window
                )

                return

            student = self.db.get_student(value)

            if not student:

                messagebox.showerror(
                    "Not Found",
                    "Student not found.",
                    parent=window
                )

                return

            confirm = messagebox.askyesno(
                "Confirm Delete",
                f"Delete student:\n\n"
                f"{student[1]}\n"
                f"Admission ID: {student[0]}\n\n"
                f"This action cannot be undone.",
                parent=window
            )

            if confirm:

                success, msg = self.db.delete_student(
                    value
                )

                if success:

                    messagebox.showinfo(
                        "Deleted",
                        msg,
                        parent=window
                    )

                    window.destroy()
                    self.refresh_dashboard()

                else:

                    messagebox.showerror(
                        "Error",
                        msg,
                        parent=window
                    )

        tk.Button(
            window,
            text="Delete Student",
            command=delete,
            bg=self.RED,
            fg="white",
            activebackground="#B91C1C",
            bd=0,
            font=("Segoe UI Semibold", 10),
            cursor="hand2",
            padx=35,
            pady=12
        ).pack()

