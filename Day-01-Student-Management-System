        def choose_photo():

            if not PIL_AVAILABLE:

                messagebox.showwarning(
                    "Pillow Required",
                    "Please install Pillow first:\n\npip install pillow",
                    parent=window
                )

                return

            path = filedialog.askopenfilename(
                parent=window,
                title="Select Student Photo",
                filetypes=[
                    ("Image Files", "*.jpg *.jpeg *.png *.bmp"),
                    ("All Files", "*.*")
                ]
            )

            if not path:
                return

            try:

                image = Image.open(path)
                image.thumbnail((160, 180))

                photo = ImageTk.PhotoImage(image)

                photo_preview.config(
                    image=photo,
                    text=""
                )

                photo_preview.image = photo
                selected_photo["path"] = path

            except Exception as e:

                messagebox.showerror(
                    "Photo Error",
                    str(e),
                    parent=window
                )

        tk.Button(
            photo_panel,
            text="Select Photo",
            command=choose_photo,
            bg=self.BLUE,
            fg="white",
            activebackground=self.BLUE2,
            activeforeground="white",
            bd=0,
            font=("Segoe UI Semibold", 9),
            cursor="hand2",
            padx=25,
            pady=10
        ).pack()

        # ====================================================
        # SAVE
        # ====================================================

        def save_student():

            if not admission.get().strip():

                messagebox.showwarning(
                    "Required",
                    "Admission ID is required.",
                    parent=window
                )

                return

            if not name.get().strip():

                messagebox.showwarning(
                    "Required",
                    "Student Name is required.",
                    parent=window
                )

                return

            photo_path = ""

            # Copy photo into application folder
            if selected_photo["path"]:

                try:

                    ext = os.path.splitext(
                        selected_photo["path"]
                    )[1]

                    filename = (
                        admission.get().strip()
                        + "_photo"
                        + ext
                    )

                    destination = os.path.join(
                        PHOTO_DIR,
                        filename
                    )

                    with open(
                        selected_photo["path"],
                        "rb"
                    ) as source:

                        with open(
                            destination,
                            "wb"
                        ) as target:

                            target.write(
                                source.read()
                            )

                    photo_path = destination

                except Exception as e:

                    messagebox.showerror(
                        "Photo Error",
                        str(e),
                        parent=window
                    )

                    return

            data = {
                "admission_id": admission.get().strip(),
                "student_name": name.get().strip(),
                "dob": dob.get().strip(),
                "gender": gender.get(),
                "student_class": student_class.get(),
                "division": division.get().strip(),
                "roll_no": roll.get().strip(),
                "phone": phone.get().strip(),
                "email": email.get().strip(),
                "address": address_text.get("1.0", "end").strip(),
                "guardian_name": guardian.get().strip(),
                "admission_date": admission_date.get().strip(),
                "photo_path": photo_path
            }

            success, message = self.db.add_student(data)

            if success:

                messagebox.showinfo(
                    "Success",
                    message,
                    parent=window
                )

                window.destroy()
                self.refresh_dashboard()

            else:

                messagebox.showerror(
                    "Error",
                    message,
                    parent=window
                )

