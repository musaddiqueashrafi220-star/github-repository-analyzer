        def export_csv():

            rows = self.db.get_all()

            if not rows:

                messagebox.showwarning(
                    "No Data",
                    "There are no students to export.",
                    parent=window
                )

                return

            path = filedialog.asksaveasfilename(
                parent=window,
                title="Save Student CSV",
                defaultextension=".csv",
                filetypes=[
                    ("CSV Files", "*.csv")
                ],
                initialfile="students.csv"
            )

            if not path:
                return

            try:

                with open(
                    path,
                    "w",
                    newline="",
                    encoding="utf-8-sig"
                ) as file:

                    writer = csv.writer(file)

                    writer.writerow([
                        "ID",
                        "Admission ID",
                        "Name",
                        "Gender",
                        "Class",
                        "Division",
                        "Roll No",
                        "Phone",
                        "Email",
                        "Guardian",
                        "Admission Date"
                    ])

                    for row in rows:
                        writer.writerow(row[:11])

                messagebox.showinfo(
                    "Export Complete",
                    f"CSV exported successfully.\n\n{path}",
                    parent=window
                )

            except Exception as e:

                messagebox.showerror(
                    "Export Error",
                    str(e),
                    parent=window
                )

        tk.Button(
            window,
            text="Export Student Data to CSV",
            command=export_csv,
            bg=self.BLUE,
            fg="white",
            activebackground=self.BLUE2,
            bd=0,
            font=("Segoe UI Semibold", 10),
            cursor="hand2",
            padx=35,
