        ).pack(anchor="w", pady=(13, 0))

    # ---------- Password Generator ----------

    def show_generator(self):
        win = tk.Toplevel(self.root)
        win.title("PASSFORGE | Password Generator")
        win.geometry("540x520")
        win.configure(bg=BG)
        win.transient(self.root)
        win.grab_set()

        panel = tk.Frame(win, bg=PANEL, padx=24, pady=22)
        panel.pack(fill="both", expand=True, padx=14, pady=14)

        self.label(panel, "PASSWORD GENERATOR", 18, ACCENT, True).pack(anchor="w")
        self.label(panel, "Generate a unique password using a secure random generator.",
                   9, MUTED).pack(anchor="w", pady=(5, 15))

        length = tk.IntVar(value=20)
        self.label(panel, "Password length", 10, TEXT, True).pack(anchor="w")
        tk.Scale(
            panel, from_=8, to=64, orient="horizontal", variable=length,
            bg=PANEL, fg=TEXT, highlightthickness=0,
            troughcolor=PANEL2, activebackground=ACCENT
        ).pack(fill="x")

        options = {}
        for key, title in [
            ("lower", "Lowercase letters"),
            ("upper", "Uppercase letters"),
            ("digits", "Numbers"),
            ("symbols", "Symbols")
        ]:
            var = tk.BooleanVar(value=True)
            options[key] = var
            tk.Checkbutton(
                panel, text=title, variable=var,
                bg=PANEL, fg=TEXT, selectcolor=PANEL2,
                activebackground=PANEL, activeforeground=TEXT
            ).pack(anchor="w")

        result = self.entry(panel)
        result.pack(fill="x", ipady=10, pady=(12, 8))
        strength = self.label(panel, "Strength: —", 10, MUTED, True)
        strength.pack(anchor="w", pady=(0, 8))

        def generate():
            pools = []
            if options["lower"].get():
                pools.append(string.ascii_lowercase)
            if options["upper"].get():
                pools.append(string.ascii_uppercase)
            if options["digits"].get():
                pools.append(string.digits)
            if options["symbols"].get():
                pools.append("!@#$%^&*()-_=+[]{};:,.?")

            if not pools:
                messagebox.showwarning(
                    "Choose options",
                    "Select at least one character type.",
                    parent=win
                )
                return

            n = length.get()
            chars = [secrets.choice(pool) for pool in pools]
            alphabet = "".join(pools)
            chars.extend(
                secrets.choice(alphabet)
                for _ in range(max(0, n - len(chars)))
            )
            secrets.SystemRandom().shuffle(chars)
            password = "".join(chars[:n])

            result.delete(0, "end")
            result.insert(0, password)
            analysis = analyze_password(password)
            strength.configure(
                text="Strength: " + analysis["label"],
                fg=ACCENT if analysis["score"] >= 3 else YELLOW
            )

        row = tk.Frame(panel, bg=PANEL)
        row.pack(fill="x")
        self.button(row, "GENERATE", generate, True).pack(side="left")
        self.button(
            row, "COPY",
            lambda: self.copy_text(result.get())
        ).pack(side="left", padx=8)
        self.button(
            row, "TEST CRACK TIME",
            lambda: self.show_analyzer()
        ).pack(side="left")

        generate()

    def close(self):
        self.conn.close()
        self.root.destroy()


