    def animate_startup(self, value):

        if value <= 100:

            width = int(280 * value / 100)

            self.progress.place(
                x=0,
                y=0,
                width=width,
                height=5
            )

            self.after(
                12,
                lambda: self.animate_startup(
                    value + 2
                )
            )

        else:

            self.after(
                350,
                self.finish_startup
            )

    def finish_startup(self):

        self.splash.destroy()

        self.create_layout()

        self.show_dashboard()

