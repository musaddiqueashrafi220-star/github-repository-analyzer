# DATABASE
# ============================================================

class Database:

    def __init__(self):
        self.create_tables()

    def connect(self):
        conn = sqlite3.connect(DB_FILE)
        conn.row_factory = sqlite3.Row
        return conn

    def create_tables(self):

        conn = self.connect()
        cur = conn.cursor()

        cur.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                date TEXT NOT NULL,
                type TEXT NOT NULL,
                category TEXT NOT NULL,
                amount REAL NOT NULL,
                note TEXT DEFAULT '',
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)

        cur.execute("""
            CREATE TABLE IF NOT EXISTS budgets (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                month TEXT UNIQUE NOT NULL,
                amount REAL NOT NULL
            )
        """)

        conn.commit()
        conn.close()

    def add_transaction(self, date, t_type, category, amount, note):

        conn = self.connect()

        conn.execute("""
            INSERT INTO transactions
            (date, type, category, amount, note)
            VALUES (?, ?, ?, ?, ?)
        """, (date, t_type, category, amount, note))

        conn.commit()
        conn.close()

    def update_transaction(
        self,
        transaction_id,
        date,
        t_type,
        category,
        amount,
        note
    ):

        conn = self.connect()

        conn.execute("""
            UPDATE transactions
            SET date=?,
                type=?,
                category=?,
                amount=?,
                note=?
            WHERE id=?
        """, (
            date,
            t_type,
            category,
            amount,
            note,
            transaction_id
        ))

        conn.commit()
        conn.close()

    def delete_transaction(self, transaction_id):

        conn = self.connect()

        conn.execute(
            "DELETE FROM transactions WHERE id=?",
            (transaction_id,)
        )

        conn.commit()
        conn.close()

    def get_transaction(self, transaction_id):

        conn = self.connect()

        row = conn.execute("""
            SELECT *
            FROM transactions
            WHERE id=?
        """, (transaction_id,)).fetchone()

        conn.close()

        return row

    def get_transactions(
        self,
        keyword="",
        t_type="All",
        month="All"
    ):

        conn = self.connect()

        query = """
            SELECT *
            FROM transactions
            WHERE 1=1
        """

        params = []

        if keyword:

            query += """
                AND (
                    category LIKE ?
                    OR note LIKE ?
                    OR date LIKE ?
                )
            """

            search = "%" + keyword + "%"

            params.extend([
                search,
                search,
                search
            ])

        if t_type != "All":

            query += """
                AND type=?
            """

            params.append(t_type)

        if month != "All":

            query += """
                AND substr(date,1,7)=?
            """

            params.append(month)

        query += """
            ORDER BY date DESC, id DESC
        """

        rows = conn.execute(
            query,
            params
        ).fetchall()

        conn.close()

        return rows

    def summary(self, month):

        conn = self.connect()

        row = conn.execute("""
            SELECT
                COALESCE(
                    SUM(
                        CASE
                            WHEN type='Income'
                            THEN amount
                            ELSE 0
                        END
                    ), 0
                ) income,

                COALESCE(
                    SUM(
                        CASE
                            WHEN type='Expense'
                            THEN amount
                            ELSE 0
                        END
                    ), 0
                ) expense

            FROM transactions
            WHERE substr(date,1,7)=?
        """, (month,)).fetchone()

        conn.close()

        income = float(row["income"])
        expense = float(row["expense"])

        return {
            "income": income,
            "expense": expense,
            "balance": income - expense
        }

    def categories(self, month):

        conn = self.connect()

        rows = conn.execute("""
            SELECT
                category,
                SUM(amount) total
            FROM transactions
            WHERE type='Expense'
            AND substr(date,1,7)=?
            GROUP BY category
            ORDER BY total DESC
        """, (month,)).fetchall()

        conn.close()

        return rows

    def set_budget(self, month, amount):

        conn = self.connect()

        conn.execute("""
            INSERT INTO budgets(month, amount)
            VALUES (?, ?)
            ON CONFLICT(month)
            DO UPDATE SET amount=excluded.amount
        """, (month, amount))

        conn.commit()
        conn.close()

    def get_budget(self, month):

        conn = self.connect()

        row = conn.execute("""
            SELECT amount
            FROM budgets
            WHERE month=?
        """, (month,)).fetchone()

        conn.close()

        if row:
            return float(row["amount"])

        return 0

    def months(self):

        conn = self.connect()

        rows = conn.execute("""
            SELECT DISTINCT substr(date,1,7) month
            FROM transactions
            ORDER BY month DESC
        """).fetchall()

        conn.close()

        result = [
            r["month"]
            for r in rows
            if r["month"]
        ]

        current = datetime.now().strftime("%Y-%m")

        if current not in result:
            result.insert(0, current)

        return result


