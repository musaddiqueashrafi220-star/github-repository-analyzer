    def draw_summary_chart(
        self,
        income,
        expense
    ):

        canvas = self.summary_canvas

        canvas.delete("all")

        width = canvas.winfo_width()
        height = canvas.winfo_height()

        if width < 200 or height < 150:
            return

        left = 60
        right = width - 35
        top = 30
        bottom = height - 50

        chart_height = bottom - top

        maximum = max(
            income,
            expense,
            1
        )

        # Grid lines
        for i in range(5):

            y = (
                bottom -
                chart_height *
                i / 4
            )

            canvas.create_line(
                left,
                y,
                right,
                y,
                fill="#E8EDF5"
            )

            value = (
                maximum *
                i /
                4
            )

            canvas.create_text(
                left - 10,
                y,
                text=f"{value:,.0f}",
                fill=self.colors["muted"],
                font=("Segoe UI", 7),
                anchor="e"
            )

        values = [
            (
                "Income",
                income,
                self.colors["green"]
            ),
            (
                "Expense",
                expense,
                self.colors["red"]
            )
        ]

        positions = [
            width * .38,
            width * .68
        ]

        bar_width = min(
            80,
            width * .15
        )

        for i, (
            name,
            value,
            color
        ) in enumerate(values):

            x = positions[i]

            target_height = (
                value /
                maximum *
                chart_height
            )

            self.animate_bar(
                canvas,
                x,
                bottom,
                bar_width,
                target_height,
                color,
                name,
                value
            )

    def animate_bar(
        self,
        canvas,
        x,
        bottom,
        bar_width,
        target_height,
        color,
        label,
        value
    ):

        steps = 20
        increment = target_height / steps

        def grow(step=0):

            if step <= steps:

                h = increment * step

                canvas.delete(
                    f"bar_{label}"
                )

                canvas.create_rectangle(
                    x - bar_width / 2,
                    bottom - h,
                    x + bar_width / 2,
                    bottom,
                    fill=color,
                    outline="",
                    tags=f"bar_{label}"
                )

                canvas.delete(
                    f"text_{label}"
                )

                canvas.create_text(
                    x,
                    bottom - h - 15,
                    text=f"₹{value:,.0f}",
                    fill=self.colors["text"],
                    font=("Segoe UI Semibold", 9),
                    tags=f"text_{label}"
                )

                canvas.delete(
                    f"label_{label}"
                )

                canvas.create_text(
                    x,
                    bottom + 25,
                    text=label,
                    fill=self.colors["text"],
                    font=("Segoe UI Semibold", 9),
                    tags=f"label_{label}"
                )

                self.after(
                    15,
                    lambda: grow(step + 1)
                )

        grow()

    def draw_category_chart(
        self,
        rows
    ):

        canvas = self.category_canvas

        canvas.delete("all")

        width = canvas.winfo_width()
        height = canvas.winfo_height()

        if width < 200 or height < 150:
            return

        if not rows:

            canvas.create_text(
                width / 2,
                height / 2,
                text="No expense data available",
                fill=self.colors["muted"],
                font=("Segoe UI", 10)
            )

            return

        rows = rows[:6]

        maximum = max(
            float(row["total"])
            for row in rows
        )

        left = 115
        right = width - 35
        top = 30

        row_height = min(
            48,
            (height - 55) /
            len(rows)
        )

        for index, row in enumerate(rows):

            category = row["category"]
            amount = float(row["total"])

            y = (
                top +
                index * row_height +
                row_height / 2
            )

            canvas.create_text(
                left - 10,
                y,
                text=category,
                fill=self.colors["text"],
                font=("Segoe UI Semibold", 8),
                anchor="e"
            )

            background_width = (
                right - left
            )

            canvas.create_rectangle(
                left,
                y - 9,
                right,
                y + 9,
                fill="#EDF1F7",
                outline=""
            )

            target = (
                amount /
                maximum *
                background_width
            )

            self.animate_category_bar(
                canvas,
                left,
                y,
                target,
                amount,
                row["category"]
            )

    def animate_category_bar(
        self,
        canvas,
        left,
        y,
        target,
        amount,
        tag
    ):

        steps = 18

        def grow(step=0):

            if step <= steps:

                width = (
                    target *
                    step /
                    steps
                )

                canvas.delete(
                    f"cat_{tag}"
                )

                canvas.create_rectangle(
                    left,
                    y - 9,
                    left + width,
                    y + 9,
                    fill=self.colors["blue"],
                    outline="",
                    tags=f"cat_{tag}"
                )

                canvas.delete(
                    f"amt_{tag}"
                )

                canvas.create_text(
                    left + width + 7,
                    y,
                    text=f"₹{amount:,.0f}",
                    fill=self.colors["muted"],
                    font=("Segoe UI Semibold", 8),
                    anchor="w",
                    tags=f"amt_{tag}"
                )

                self.after(
                    15,
                    lambda: grow(step + 1)
                )

        grow()

