                tree.delete(item)

            for row in rows:

                tree.insert(
                    "",
                    "end",
                    values=(
                        row["id"],
                        row["date"],
                        row["type"],
                        row["category"],
                        f"₹{row['amount']:,.2f}",
                        row["note"]
                    )
                )

        search_var.trace_add(
            "write",
            lambda *args: load()
        )

        type_combo.bind(
            "<<ComboboxSelected>>",
            lambda e: load()
        )

        month_combo.bind(
            "<<ComboboxSelected>>",
            lambda e: load()
        )

        buttons = tk.Frame(
            win,
            bg=self.colors["bg"]
        )

        buttons.pack(
            fill="x",
            padx=30,
            pady=(8, 20)
        )

        def edit():

            selected = tree.selection()

            if not selected:

                messagebox.showwarning(
                    "Select",
                    "Please select a transaction.",
                    parent=win
                )

                return

            values = tree.item(
                selected[0],
                "values"
            )

            transaction = (
                self.db.get_transaction(
                    int(values[0])
                )
            )

            self.form_window(
                "Edit Transaction",
                transaction,
                load
            )

        def delete():

            selected = tree.selection()

            if not selected:

                messagebox.showwarning(
                    "Select",
                    "Please select a transaction.",
                    parent=win
                )

                return

            values = tree.item(
                selected[0],
                "values"
            )

            answer = messagebox.askyesno(
                "Delete Transaction",
                "Delete selected transaction?",
                parent=win
            )

            if answer:

                self.db.delete_transaction(
                    int(values[0])
                )

                load()

                self.refresh_after_change()

        tk.Button(
            buttons,
            text="Edit Selected",
            command=edit,
            bg=self.colors["blue"],
            fg="white",
            relief="flat",
            cursor="hand2",
            font=("Segoe UI Semibold", 9),
            padx=22,
            pady=9
        ).pack(
            side="left"
        )

        tk.Button(
            buttons,
            text="Delete Selected",
            command=delete,
            bg=self.colors["red"],
            fg="white",
            relief="flat",
            cursor="hand2",
            font=("Segoe UI Semibold", 9),
            padx=22,
            pady=9
        ).pack(
            side="left",
            padx=8
        )

        tk.Button(
            buttons,
            text="Refresh",
            command=load,
            bg="#E2E8F0",
            fg=self.colors["text"],
            relief="flat",
            cursor="hand2",
            font=("Segoe UI Semibold", 9),
            padx=22,
            pady=9
        ).pack(
            side="left"
        )

        tree.bind(
            "<Double-1>",
            lambda e: edit()
        )

        load()

    def page_header_window(
        self,
        win,
        title,
        subtitle
    ):

        frame = tk.Frame(
            win,
            bg=self.colors["bg"]
        )

        frame.pack(
            fill="x",
            padx=30,
            pady=(25, 8)
        )

        tk.Label(
            frame,
            text=title,
            bg=self.colors["bg"],
            fg=self.colors["text"],
            font=("Segoe UI Semibold", 25)
        ).pack(
            anchor="w"
        )

        tk.Label(
            frame,
            text=subtitle,
            bg=self.colors["bg"],
            fg=self.colors["muted"],
            font=("Segoe UI", 9)
        ).pack(
            anchor="w"
        )

        return frame

    # ========================================================
    # REPORTS
    # ========================================================

    def open_reports(self):

        win = tk.Toplevel(self)

        win.title("Reports & Export")
        win.geometry("950x680")
        win.minsize(800, 550)
        win.configure(
            bg=self.colors["bg"]
        )

        self.page_header_window(
            win,
            "Reports & Export",
            "Analyze your monthly finances and export data."
        )

        controls = tk.Frame(
            win,
            bg=self.colors["white"],
            highlightbackground=self.colors["border"],
            highlightthickness=1
        )

        controls.pack(
            fill="x",
            padx=30,
            pady=10
        )

        month_var = tk.StringVar(
            value=datetime.now().strftime("%Y-%m")
        )

        tk.Label(
            controls,
            text="Report Month",
            bg=self.colors["white"],
            fg=self.colors["text"],
            font=("Segoe UI Semibold", 9)
        ).pack(
            side="left",
            padx=(15, 8)
        )

        combo = ttk.Combobox(
            controls,
            textvariable=month_var,
            values=self.db.months(),
            state="readonly",
            width=14
        )

        combo.pack(
            side="left",
            pady=12
        )

        summary_panel = self.panel(
            win
        )

        summary_panel.pack(
            fill="x",
            padx=30,
            pady=8
        )

        value_labels = {}

        for title, color in [
            ("Income", self.colors["green"]),
            ("Expense", self.colors["red"]),
            ("Balance", self.colors["blue"]),
            ("Budget", self.colors["orange"])
        ]:

            f = tk.Frame(
                summary_panel,
                bg=self.colors["white"]
            )

            f.pack(
                side="left",
                fill="x",
                expand=True,
                pady=18
            )

            value = tk.Label(
                f,
                text="₹0",
                bg=self.colors["white"],
                fg=color,
                font=("Segoe UI Semibold", 18)
            )

            value.pack()

            tk.Label(
                f,
                text=title,
                bg=self.colors["white"],
                fg=self.colors["muted"],
                font=("Segoe UI Semibold", 8)
            ).pack()

            value_labels[title] = value

        table_panel = self.panel(
            win
        )

        table_panel.pack(
            fill="both",
            expand=True,
            padx=30,
            pady=8
        )

        tree = ttk.Treeview(
            table_panel,
            columns=("Category", "Amount"),
            show="headings"
        )

        tree.heading(
            "Category",
            text="Category"
        )

        tree.heading(
            "Amount",
            text="Amount"
        )

        tree.column(
            "Category",
            width=350
        )

        tree.column(
            "Amount",
            width=200,
            anchor="center"
        )

        tree.pack(
            fill="both",
            expand=True
        )

        def load():

            month = month_var.get()

            summary = self.db.summary(
                month
            )

            budget = self.db.get_budget(
                month
            )

            value_labels["Income"].config(
                text=f"₹{summary['income']:,.2f}"
            )

            value_labels["Expense"].config(
                text=f"₹{summary['expense']:,.2f}"
            )

            value_labels["Balance"].config(
                text=f"₹{summary['balance']:,.2f}"
            )

            value_labels["Budget"].config(
                text=f"₹{budget:,.2f}"
            )

            for item in tree.get_children():
                tree.delete(item)

            for row in self.db.categories(
                month
            ):

                tree.insert(
                    "",
                    "end",
                    values=(
                        row["category"],
                        f"₹{row['total']:,.2f}"
                    )
                )

        combo.bind(
            "<<ComboboxSelected>>",
            lambda e: load()
        )

        bottom = tk.Frame(
            win,
            bg=self.colors["bg"]
        )

        bottom.pack(
            fill="x",
            padx=30,
            pady=(5, 20)
        )

        def export():

            month = month_var.get()

            rows = self.db.get_transactions(
                month=month
            )

            if not rows:

                messagebox.showwarning(
                    "No Data",
                    "There is no data for this month.",
                    parent=win
                )

                return

            path = filedialog.asksaveasfilename(
                parent=win,
                defaultextension=".csv",
                initialfile=(
                    f"Finova_Report_{month}.csv"
                ),
                filetypes=[
                    ("CSV Files", "*.csv")
                ]
            )

            if not path:
                return

            try:

                with open(
                    path,
                    "w",
                    newline="",
                    encoding="utf-8-sig"
                ) as file:

                    writer = csv.writer(
                        file
                    )

                    writer.writerow([
                        "ID",
                        "Date",
                        "Type",
                        "Category",
                        "Amount",
                        "Note"
                    ])

                    for row in rows:

                        writer.writerow([
                            row["id"],
                            row["date"],
                            row["type"],
                            row["category"],
                            row["amount"],
                            row["note"]
                        ])

                messagebox.showinfo(
                    "Export Complete",
                    "CSV report exported successfully.",
                    parent=win
                )

            except Exception as e:

                messagebox.showerror(
                    "Export Error",
                    str(e),
                    parent=win
                )

        tk.Button(
            bottom,
            text="Export CSV",
            command=export,
            bg=self.colors["green"],
            fg="white",
            relief="flat",
            cursor="hand2",
            font=("Segoe UI Semibold", 9),
            padx=28,
            pady=10
        ).pack(
            side="right"
        )

        load()


