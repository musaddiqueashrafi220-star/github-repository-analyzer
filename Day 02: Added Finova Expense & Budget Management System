    # ========================================================
    # ANIMATED NUMBER
    # ========================================================

    def animate_number(
        self,
        label,
        target,
        prefix="₹"
    ):

        try:
            target = float(target)
        except:
            target = 0

        duration = 500
        steps = 25
        step_value = target / steps
        step_time = duration // steps

        def update(step=0):

            if step <= steps:

                value = step_value * step

                label.config(
                    text=f"{prefix}{value:,.0f}"
                )

                self.after(
                    step_time,
                    lambda: update(step + 1)
                )

            else:

                label.config(
                    text=f"{prefix}{target:,.2f}"
                )

        update()

    def refresh_dashboard(self):

        month = self.dashboard_month.get()

        summary = self.db.summary(
            month
        )

        budget = self.db.get_budget(
            month
        )

        remaining = (
            budget -
            summary["expense"]
        )

        self.animate_number(
            self.card_income,
            summary["income"]
        )

        self.animate_number(
            self.card_expense,
            summary["expense"]
        )

        self.animate_number(
            self.card_balance,
            summary["balance"]
        )

        if budget > 0:

            self.animate_number(
                self.card_budget,
                max(remaining, 0)
            )

            percent = (
                summary["expense"] /
                budget
            ) * 100

            percent = min(
                percent,
                100
            )

            self.budget_percent.config(
                text=f"{percent:.0f}%"
            )

            self.budget_text.config(
                text=(
                    f"Monthly Budget  •  "
                    f"₹{budget:,.2f}"
                )
            )

            if percent < 70:

                color = self.colors["green"]

                text = (
                    f"₹{summary['expense']:,.2f} "
                    f"spent — budget is under control."
                )

            elif percent < 100:

                color = self.colors["orange"]

                text = (
                    f"₹{summary['expense']:,.2f} "
                    f"spent — approaching budget limit."
                )

            else:

                color = self.colors["red"]

                text = (
                    f"₹{summary['expense']:,.2f} "
                    f"spent — budget exceeded."
                )

            self.budget_status.config(
                text=text,
                fg=color
            )

            self.animate_progress(
                percent,
                color
            )

        else:

            self.card_budget.config(
                text="Not Set"
            )

            self.budget_percent.config(
                text="0%"
            )

            self.budget_text.config(
                text="Monthly Budget"
            )

            self.budget_status.config(
                text=(
                    "No monthly budget set. "
                    "Open Monthly Budget to create one."
                ),
                fg=self.colors["muted"]
            )

            self.animate_progress(
                0,
                self.colors["blue"]
            )

        self.refresh_graphs()

    # ========================================================
    # ANIMATED PROGRESS
    # ========================================================

    def animate_progress(
        self,
        percent,
        color
    ):

        self.budget_bar.config(
            bg=color
        )

        self.budget_bar_bg.update_idletasks()

        max_width = (
            self.budget_bar_bg.winfo_width()
        )

        target_width = int(
            max_width *
            percent /
            100
        )

        def step(width=0):

            if width <= target_width:

                self.budget_bar.place(
                    x=0,
                    y=0,
                    width=width,
                    height=9
                )

                self.after(
                    8,
                    lambda: step(
                        width + max(
                            1,
                            target_width // 30
                        )
                    )
                )

            else:

                self.budget_bar.place(
                    x=0,
                    y=0,
                    width=target_width,
                    height=9
                )

        step()

