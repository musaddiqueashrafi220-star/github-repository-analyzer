            ("path", "Full path", 650)
        ], height=13)
        tree._container.pack(fill="both", expand=True)
        self.cleanup_tree = tree
        self._refresh_cleanup()

    def _refresh_cleanup(self):
        if not hasattr(self, "cleanup_tree") or not self.cleanup_tree.winfo_exists():
            return
        try:
            threshold = max(0, float(self.min_size_var.get())) * 1024 * 1024
        except ValueError:
            messagebox.showerror("Invalid size", "Enter a valid minimum size in MB.")
            return
        tree = self.cleanup_tree
        tree.delete(*tree.get_children())
        candidates = [f for f in self.files if f["size"] >= threshold]
        for f in sorted(candidates, key=lambda x: x["size"], reverse=True):
            tree.insert("", "end", values=(f["name"], fmt_size(f["size"]),
                                           fmt_date(f["mtime"]), f["path"]))
        if not candidates:
            self.status_var.set("No files meet this size threshold.")

    def _delete_selected_cleanup(self):
        tree = getattr(self, "cleanup_tree", None)
        if tree is None or not tree.winfo_exists():
            return
        selected = tree.selection()
        if not selected:
            messagebox.showinfo("Nothing selected", "Select the exact files you want to delete.")
            return
        paths = [tree.item(i, "values")[3] for i in selected]
        preview = "\n".join(paths[:5])
        if len(paths) > 5:
            preview += f"\n… and {len(paths) - 5} more"
        if not messagebox.askyesno(
            "Confirm permanent deletion",
            f"You are about to permanently delete {len(paths)} selected file(s):\n\n{preview}\n\n"
            "This action cannot be undone. Ensure these files are not needed. Continue?"
        ):
            return
        deleted, failed = 0, []
        for path in paths:
            try:
                # Re-check file exists and is a regular non-symlink file.
                if os.path.islink(path) or not os.path.isfile(path):
                    raise OSError("Not a regular file or no longer exists")
                os.remove(path)
                deleted += 1
                self.file_by_path.pop(path, None)
            except OSError as exc:
                failed.append(f"{path}: {exc}")
        removed_paths = set(paths) - {x.split(": ", 1)[0] for x in failed}
        self.files = [f for f in self.files if f["path"] not in removed_paths]
        self.duplicates = [f for f in self.duplicates if f["path"] not in removed_paths]
        self._refresh_overview()
        self._show_tab("Cleanup Review")
        message = f"Deleted {deleted} file(s)."
        if failed:
            message += f"\n{len(failed)} file(s) could not be deleted."
        messagebox.showinfo("Cleanup result", message)

    def _export_csv(self, kind):
        if kind == "duplicates":
            records = self.duplicates
            default = "duplicate_files.csv"
        else:
            records = self.files
            default = "storage_scan.csv"
        if not records:
            messagebox.showinfo("No data", "No records to export yet.")
            return
        path = filedialog.asksaveasfilename(title="Export scan results",
                                            defaultextension=".csv",
                                            initialfile=default,
                                            filetypes=[("CSV files", "*.csv")])
        if not path:
            return
        try:
            with open(path, "w", newline="", encoding="utf-8-sig") as handle:
                writer = csv.writer(handle)
                writer.writerow(["Name", "Full Path", "Size Bytes", "Size Human",
                                 "Extension", "Modified", "SHA-256"])
                for f in records:
                    writer.writerow([f["name"], f["path"], f["size"], fmt_size(f["size"]),
                                     f["ext"], fmt_date(f["mtime"]), f.get("hash") or ""])
            messagebox.showinfo("Export complete", f"Exported {len(records):,} record(s) to:\n{path}")
        except OSError as exc:
            messagebox.showerror("Export failed", str(exc))


def main():
    root = tk.Tk()
    app = StorageIntelligence(root)
    root.mainloop()

if __name__ == "__main__":
    main()
