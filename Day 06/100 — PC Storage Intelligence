        tree = self._make_tree(self.content, [
            ("name", "File", 220), ("size", "Size", 100), ("hash", "SHA-256", 270),
            ("path", "Full path", 580)
        ], height=14)
        tree._container.pack(fill="both", expand=True)
        self.dupe_tree = tree
        for f in self.duplicates:
            tree.insert("", "end", values=(f["name"], fmt_size(f["size"]), f.get("hash") or "", f["path"]))
        row = tk.Frame(self.content, bg=PANEL)
        row.pack(fill="x", pady=(10, 0))
        tk.Label(row, text=f"{len(self.duplicates):,} files in duplicate groups",
                 bg=PANEL, fg=TEXT).pack(side="left")
        self._button(row, "Export duplicates CSV", lambda: self._export_csv("duplicates"),
                     PANEL2, TEXT).pack(side="right")

