    def _make_tree(self, parent, columns, height=12):
        frame = tk.Frame(parent, bg=PANEL)
        tree = ttk.Treeview(frame, columns=[c[0] for c in columns],
                            show="headings", height=height, selectmode="extended")
        for key, label, width in columns:
            tree.heading(key, text=label)
            tree.column(key, width=width, minwidth=60,
                         anchor="w" if key in ("name", "path", "ext") else "center")
        yscroll = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
        xscroll = ttk.Scrollbar(frame, orient="horizontal", command=tree.xview)
        tree.configure(yscrollcommand=yscroll.set, xscrollcommand=xscroll.set)
        tree.grid(row=0, column=0, sticky="nsew")
        yscroll.grid(row=0, column=1, sticky="ns")
        xscroll.grid(row=1, column=0, sticky="ew")
        frame.rowconfigure(0, weight=1)
        frame.columnconfigure(0, weight=1)
        tree._container = frame
        return tree

    def _refresh_overview(self):
        total = sum(f["size"] for f in self.files)
        self.card_values["total"].configure(text=fmt_size(total))
        self.card_values["count"].configure(text=f"{len(self.files):,}")
        self.card_values["folders"].configure(text=f"{getattr(self, 'folder_count', 0):,}")
        self.card_values["duplicates"].configure(text=f"{len(self.duplicates):,}")
        if not hasattr(self, "chart") or not self.chart.winfo_exists():
            return
        self.chart.delete("all")
        ext_totals = defaultdict(int)
        for f in self.files:
            ext_totals[f["ext"]] += f["size"]
        items = sorted(ext_totals.items(), key=lambda x: x[1], reverse=True)[:8]
        if not items:
            self.chart.create_text(10, 20, text="No scan results yet", fill=MUTED,
                                   anchor="nw", font=("Segoe UI", 10))
        else:
            max_size = max(v for _, v in items) or 1
            y = 10
            for ext, size in items:
                self.chart.create_text(4, y + 8, text=ext[:13], fill=TEXT, anchor="w",
                                       font=("Segoe UI", 9))
                x0, x1 = 100, 100 + int(180 * size / max_size)
                self.chart.create_rectangle(x0, y, x1, y + 17, fill=ACCENT, outline="")
                self.chart.create_text(x1 + 6, y + 8, text=fmt_size(size), fill=MUTED,
                                       anchor="w", font=("Segoe UI", 8))
                y += 28
        if hasattr(self, "large_tree") and self.large_tree.winfo_exists():
            for item in self.large_tree.get_children():
                self.large_tree.delete(item)
            for f in sorted(self.files, key=lambda x: x["size"], reverse=True)[:10]:
                self.large_tree.insert("", "end", values=(
                    f["name"], fmt_size(f["size"]), fmt_date(f["mtime"])))
        if hasattr(self, "insight_label") and self.insight_label.winfo_exists():
            if self.files:
                biggest = max(self.files, key=lambda x: x["size"])
                total = sum(f["size"] for f in self.files)
                self.insight_label.configure(
                    text=f"• {len(self.files):,} files occupy {fmt_size(total)}.\n"
                         f"• Largest file: {biggest['name']} ({fmt_size(biggest['size'])}).\n"
                         f"• {len(self.duplicates)} duplicate file(s) detected.\n"
                         "• Review files before removing anything.")
            else:
                self.insight_label.configure(text="Scan a folder to generate storage insights.")

    def _browse(self):
        folder = filedialog.askdirectory(title="Choose a folder or drive to scan",
                                         initialdir=self.path_var.get() if os.path.isdir(self.path_var.get()) else os.path.expanduser("~"))
        if folder:
            self.path_var.set(folder)

    def _start_scan(self):
        if self.scanning:
            return
        path = os.path.abspath(os.path.expanduser(self.path_var.get().strip().strip('"')))
        if not os.path.isdir(path):
            messagebox.showerror("Invalid location", "Choose an existing folder or drive.")
            return
        self.scan_root = path
        self.files = []
        self.file_by_path = {}
        self.duplicates = []
        self.folder_count = 0
        self.cancel_event.clear()
        self.scanning = True
        self.scan_started = time.time()
        self.scan_btn.configure(state="disabled")
        self.browse_btn.configure(state="disabled")
        self.progress.start(12)
        self.status_var.set(f"Scanning {path} …")
        self._refresh_overview()
        self._show_tab("Overview")
        threading.Thread(target=self._scan_worker, args=(path,), daemon=True).start()

    def _cancel_scan(self):
        if self.scanning:
            self.cancel_event.set()
            self.status_var.set("Cancellation requested — finishing current file operation…")

    def _scan_worker(self, root_path):
        count = 0
        folder_count = 0
        total_size = 0
        inaccessible = 0
        try:
            for current, dirs, names in os.walk(root_path, topdown=True, followlinks=False):
                if self.cancel_event.is_set():
                    break
                # Do not follow directory symlinks and prune inaccessible/system-heavy folders by permission errors.
                dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(current, d))]
                folder_count += 1
                for name in names:
                    if self.cancel_event.is_set():
                        break
                    path = os.path.join(current, name)
                    try:
                        if os.path.islink(path):
                            continue
                        stat = os.stat(path, follow_symlinks=False)
                        if not os.path.isfile(path):
                            continue
                        ext = os.path.splitext(name)[1].lower() or "[no extension]"
                        record = {
                            "path": path, "name": name, "size": stat.st_size,
                            "mtime": stat.st_mtime, "ext": ext,
                            "hash": None, "access": stat.st_mode
                        }
                        self.events.put(("file", record))
                        count += 1
                        total_size += stat.st_size
                    except (OSError, PermissionError):
                        inaccessible += 1
                if folder_count % 25 == 0:
                    self.events.put(("progress", (count, folder_count, total_size, current)))
            self.events.put(("scan_done", (count, folder_count, total_size, inaccessible,
                                            self.cancel_event.is_set())))
        except Exception as exc:
            self.events.put(("scan_error", str(exc)))

    def _poll_events(self):
        try:
            while True:
                event, data = self.events.get_nowait()
                if event == "file":
                    self.files.append(data)
                    self.file_by_path[data["path"]] = data
                    if len(self.files) % 100 == 0:
                        self.status_var.set(f"Scanned {len(self.files):,} files · {data['path']}")
                elif event == "progress":
                    count, folders, size, current = data
                    self.status_var.set(f"{count:,} files · {folders:,} folders · {fmt_size(size)} · {current}")
                elif event == "scan_done":
                    count, folders, size, inaccessible, cancelled = data
                    self.scanning = False
                    self.folder_count = folders
                    self.progress.stop()
                    self.scan_btn.configure(state="normal")
                    self.browse_btn.configure(state="normal")
                    elapsed = time.time() - (self.scan_started or time.time())
                    status = "Scan cancelled" if cancelled else "Scan complete"
                    self.status_var.set(
                        f"{status}: {count:,} files · {folders:,} folders · {fmt_size(size)} · "
                        f"{inaccessible:,} unreadable entries · {elapsed:.1f}s")
                    self._refresh_overview()
                    self._show_tab(self.current_tab)
                    # Hash candidates in background, grouped by size to reduce unnecessary reads.
                    threading.Thread(target=self._find_duplicates_worker, daemon=True).start()
                elif event == "dupes_done":
                    self.duplicates = data
                    self.card_values["duplicates"].configure(text=f"{len(self.duplicates):,}")
                    self.status_var.set(self.status_var.get().split(" · Duplicate check")[0] + f" · Duplicate check: {len(data)} files in duplicate groups")
                    if self.current_tab == "Duplicates":
                        self._show_tab("Duplicates")
                elif event == "scan_error":
                    self.scanning = False
                    self.progress.stop()
                    self.scan_btn.configure(state="normal")
                    self.browse_btn.configure(state="normal")
                    messagebox.showerror("Scan error", data)
                    self.status_var.set("Scan stopped due to an error.")
        except queue.Empty:
            pass
        self.root.after(120, self._poll_events)

    def _find_duplicates_worker(self):
        by_size = defaultdict(list)
        for f in self.files:
            if f["size"] > 0:
                by_size[f["size"]].append(f)
        candidates = [group for group in by_size.values() if len(group) > 1]
        found = []
        total_groups = len(candidates)
        checked = 0
        for group in candidates:
            if self.cancel_event.is_set():
                break
            hashes = defaultdict(list)
            for f in group:
                try:
                    digest = hashlib.sha256()
                    with open(f["path"], "rb") as stream:
                        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                            if self.cancel_event.is_set():
                                break
                            digest.update(chunk)
                    f["hash"] = digest.hexdigest()
                    hashes[f["hash"]].append(f)
                except (OSError, PermissionError):
                    continue
            for digest, same in hashes.items():
                if len(same) > 1:
                    found.extend(same)
            checked += 1
            if checked % 20 == 0:
                self.events.put(("dupe_progress", (checked, total_groups)))
        self.events.put(("dupes_done", found))

    def _files_view(self):
        toolbar = tk.Frame(self.content, bg=PANEL)
        toolbar.pack(fill="x", pady=(0, 10))
        tk.Label(toolbar, text="Search", bg=PANEL, fg=MUTED).pack(side="left")
        search = tk.Entry(toolbar, textvariable=self.search_var, bg=PANEL2, fg=TEXT,
                          insertbackground=TEXT, relief="flat", width=25)
        search.pack(side="left", padx=(8, 14), ipady=7)
        tk.Label(toolbar, text="Type", bg=PANEL, fg=MUTED).pack(side="left")
        types = ["All types"] + sorted({f["ext"] for f in self.files})
        combo = ttk.Combobox(toolbar, textvariable=self.ext_var, values=types,
                             state="readonly", width=18)
        combo.pack(side="left", padx=(8, 14))
        self._button(toolbar, "Apply filters", self._refresh_file_table, "#1d4ed8", "white").pack(side="left")
        self._button(toolbar, "Export CSV", lambda: self._export_csv("files"), PANEL2, TEXT).pack(side="right")
        tree = self._make_tree(self.content, [
            ("name", "File name", 220), ("size", "Size", 100), ("ext", "Type", 120),
            ("modified", "Modified", 135), ("path", "Full path", 560)
        ], height=14)
        tree._container.pack(fill="both", expand=True)
        self.file_tree = tree
        self._refresh_file_table()
        search.bind("<Return>", lambda _e: self._refresh_file_table())
        combo.bind("<<ComboboxSelected>>", lambda _e: self._refresh_file_table())

    def _refresh_file_table(self):
        if not hasattr(self, "file_tree") or not self.file_tree.winfo_exists():
            return
        query = self.search_var.get().strip().lower()
        ext = self.ext_var.get()
        tree = self.file_tree
        tree.delete(*tree.get_children())
        records = sorted(self.files, key=lambda x: x["size"], reverse=True)
        for f in records:
            if query and query not in f["name"].lower() and query not in f["path"].lower():
                continue
            if ext != "All types" and f["ext"] != ext:
                continue
            tree.insert("", "end", values=(f["name"], fmt_size(f["size"]), f["ext"],
                                           fmt_date(f["mtime"]), f["path"]))

