        tk.Label(
            frame,
            text=title,
            bg="#111c2e",
            fg="#9eb5d3",
            font=("Segoe UI", 9, "bold")
        ).pack(anchor="w", padx=12, pady=5)

        value = tk.Label(
            frame,
            text="0",
            bg="#111c2e",
            fg="#57d6c7",
            font=("Segoe UI", 18, "bold")
        )

        value.pack(anchor="w", padx=12, pady=5)

        return value

    # SPEED FORMAT
    def format_speed(self, speed):
        units = ["B/s", "KB/s", "MB/s", "GB/s"]

        for unit in units:
            if speed < 1024:
                return f"{speed:.1f} {unit}"
            speed /= 1024

        return f"{speed:.1f} GB/s"

    # CONNECTION ADDRESS
    def address(self, addr):
        if not addr:
            return "-"

        try:
            return f"{addr.ip}:{addr.port}"
        except AttributeError:
            return str(addr)

    # SECURITY ALERT
    def add_alert(self, severity, message):

        self.alert_total += 1

        self.alert_label.config(
            text=str(self.alert_total)
        )

        self.alert_table.insert(
            "",
            0,
            values=(
                datetime.now().strftime("%H:%M:%S"),
                severity,
                message
            )
        )

        with sqlite3.connect(DB) as con:
            con.execute(
                "INSERT INTO alerts(time,severity,message) VALUES(?,?,?)",
                (
                    datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    severity,
                    message
                )
            )

    # CONNECTION MONITOR
    def monitor_connections(self):

        for item in self.connection_table.get_children():
            self.connection_table.delete(item)

        try:
            connections = psutil.net_connections(kind="inet")
        except (psutil.AccessDenied, PermissionError):
            connections = []

        self.connection_label.config(
            text=str(len(connections))
        )

        notable_ports = {
            21, 23, 2323, 4444,
            5555, 6667, 31337
        }

        for c in connections[:200]:

            protocol = (
                "TCP" if c.type == socket.SOCK_STREAM else "UDP"
            )

            local = self.address(c.laddr)
            remote = self.address(c.raddr) if c.raddr else "-"
            status = c.status or "BOUND"

            try:
                process = (
                    psutil.Process(c.pid).name()
                    if c.pid else "System"
                )
            except (psutil.Error, PermissionError):
                process = "Unknown"

            self.connection_table.insert(
                "",
                "end",
                values=(
                    protocol,
                    local,
                    remote,
                    status,
                    process
                )
            )

            key = (protocol, local, remote, process)

            if remote != "-" and key not in self.seen_connections:

                self.seen_connections.add(key)

                try:
                    port = int(remote.rsplit(":", 1)[1])
                except (ValueError, IndexError):
                    port = 0

                if port in notable_ports:
                    self.add_alert(
                        "MEDIUM",
                        f"{process}: connection to port {port}. Verify it."
                    )

                else:
                    self.log_event(
                        "NEW_CONNECTION",
                        f"{process} -> {remote}"
                    )

            # Selected listening services
            if status == "LISTEN":
                try:
                    port = int(local.rsplit(":", 1)[1])
                except (ValueError, IndexError):
                    port = 0

                listen_key = ("LISTEN", local, process)

                if port in (22, 3389, 445, 5900) and listen_key not in self.seen_connections:
                    self.seen_connections.add(listen_key)
                    self.add_alert(
                        "MEDIUM",
                        f"Service listening on port {port}: {process}"
                    )

        if len(connections) > 150:
            key = ("HIGH_CONNECTION_COUNT",)

            if key not in self.seen_connections:
                self.seen_connections.add(key)
                self.add_alert(
                    "MEDIUM",
                    f"High connection count: {len(connections)}"
                )

    # LIVE BANDWIDTH
    def refresh_data(self):

        now = time.time()
        current = psutil.net_io_counters()

        elapsed = max(now - self.previous_time, 0.001)

        download = max(
            0,
            current.bytes_recv - self.previous.bytes_recv
        ) / elapsed

        upload = max(
            0,
            current.bytes_sent - self.previous.bytes_sent
        ) / elapsed

        self.previous = current
        self.previous_time = now

        self.download_label.config(
            text=self.format_speed(download)
        )

        self.upload_label.config(
            text=self.format_speed(upload)
        )

        self.download_data.append(download / 1024)
        self.upload_data.append(upload / 1024)

        self.download_data = self.download_data[-30:]
        self.upload_data = self.upload_data[-30:]

        if Figure:
            x = list(range(len(self.download_data)))

            self.line_down.set_data(x, self.download_data)
            self.line_up.set_data(x, self.upload_data)

            self.ax.set_xlim(0, 29)

            maximum = max(
                self.download_data + self.upload_data + [10]
            )

            self.ax.set_ylim(0, maximum * 1.2)

            self.canvas.draw_idle()

        self.monitor_connections()

        self.status.config(
            text="● MONITORING | Last update: "
            + datetime.now().strftime("%H:%M:%S")
        )

        self.log_event(
            "BANDWIDTH",
            f"Download={download:.0f} B/s, Upload={upload:.0f} B/s"
        )

        self.root.after(2000, self.refresh_data)

    # LAN DEVICE DISCOVERY
    def scan_network(self):

        if self.scanning:
            return

        self.scanning = True

        self.status.config(
            text="● SCANNING LOCAL NETWORK..."
        )

        threading.Thread(
            target=self.scan_worker,
            daemon=True
        ).start()

    def scan_worker(self):

        found = {}

        try:
            sock = socket.socket(
                socket.AF_INET,
                socket.SOCK_DGRAM
            )

            try:
                sock.connect(("8.8.8.8", 80))
                local_ip = sock.getsockname()[0]
            finally:
                sock.close()

            network = ipaddress.ip_network(
                local_ip + "/24",
                strict=False
            )

            if platform.system() == "Windows":

                for ip in network.hosts():

                    if str(ip) == local_ip:
                        continue

                    subprocess.run(
                        ["ping", "-n", "1", "-w", "100", str(ip)],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        creationflags=getattr(
                            subprocess,
                            "CREATE_NO_WINDOW",
                            0
                        )
                    )

                result = subprocess.run(
                    ["arp", "-a"],
                    capture_output=True,
                    text=True,
                    errors="ignore",
                    creationflags=getattr(
                        subprocess,
                        "CREATE_NO_WINDOW",
                        0
                    )
                )

                for line in result.stdout.splitlines():

                    parts = line.split()

                    if len(parts) >= 2:

                        try:
                            ipaddress.ip_address(parts[0])

                            if "-" in parts[1]:
                                found[parts[0]] = parts[1]

                        except ValueError:
                            pass

            found[local_ip] = "This PC"

        except Exception as error:
            self.log_event("SCAN_ERROR", error)

        self.root.after(
            0,
            lambda data=found: self.finish_scan(data)
        )

    def finish_scan(self, found):

        for item in self.device_table.get_children():
            self.device_table.delete(item)

        for ip, mac in sorted(found.items()):
            self.device_table.insert(
                "",
                "end",
                values=(ip, mac)
            )

        self.scanning = False

        self.status.config(
            text=f"● MONITORING | Found {len(found)} LAN entries"
        )

        self.log_event(
            "LAN_SCAN",
            f"{len(found)} entries"
        )

    # PDF REPORT
    def export_pdf(self):

        try:
            from reportlab.lib import colors
            from reportlab.lib.pagesizes import A4
            from reportlab.platypus import (
                SimpleDocTemplate,
                Paragraph,
                Table,
                TableStyle,
                Spacer
            )
            from reportlab.lib.styles import getSampleStyleSheet

        except ImportError:
            messagebox.showerror(
                "Missing Library",
                "Run: py -m pip install reportlab"
            )
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".pdf",
            filetypes=[("PDF Files", "*.pdf")],
            initialfile="NetShield_Report.pdf"
        )

        if not path:
            return

        try:
            connections = psutil.net_connections(kind="inet")
        except psutil.Error:
            connections = []

        data = [
            ["Protocol", "Local", "Remote", "Status"]
        ]

        for c in connections[:40]:

            protocol = (
                "TCP" if c.type == socket.SOCK_STREAM else "UDP"
            )

            data.append([
                protocol,
                self.address(c.laddr),
                self.address(c.raddr) if c.raddr else "-",
                c.status
            ])

        table = Table(data, repeatRows=1)

        table.setStyle(
            TableStyle([
                ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#203a58")),
                ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
                ("GRID", (0, 0), (-1, -1), 0.4, colors.grey),
                ("FONTSIZE", (0, 0), (-1, -1), 8)
            ])
        )

        styles = getSampleStyleSheet()

        story = [
            Paragraph(
                "NetShield Pro - Network Snapshot",
                styles["Title"]
            ),
            Paragraph(
                "Generated: " + datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                styles["Normal"]
            ),
            Spacer(1, 12),
            Paragraph(
                "Educational monitoring report. Alerts are heuristic indicators, not proof of malware.",
                styles["Normal"]
            ),
            Spacer(1, 12),
            table
        ]

        from reportlab.platypus import SimpleDocTemplate

        SimpleDocTemplate(
            path,
            pagesize=A4
        ).build(story)

        messagebox.showinfo(
            "Success",
            "PDF report saved successfully!"
        )

    def close(self):
        self.root.destroy()


