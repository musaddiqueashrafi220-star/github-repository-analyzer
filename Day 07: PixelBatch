
import os
import threading
import tkinter as tk
from tkinter import filedialog, messagebox, ttk
from PIL import Image, ImageDraw, ImageFont, ImageOps

APP_NAME = "PixelBatch | Image Studio"


class PixelBatch:
    def __init__(self, root):
        self.root = root
        self.root.title(APP_NAME)
        self.root.geometry("900x650")
        self.root.minsize(760, 570)
        self.root.configure(bg="#101827")

        self.files = []
        self.output_folder = os.path.join(
            os.path.expanduser("~"), "Desktop", "PixelBatch_Output"
        )

        self.width_var = tk.StringVar(value="1200")
        self.height_var = tk.StringVar(value="1200")
        self.format_var = tk.StringVar(value="JPEG")
        self.quality_var = tk.IntVar(value=85)
        self.watermark_var = tk.StringVar()
        self.keep_ratio_var = tk.BooleanVar(value=True)
        self.status_var = tk.StringVar(value="Ready — add images to begin")

        self.build_ui()

    def build_ui(self):
        style = ttk.Style()
        style.theme_use("clam")
        style.configure(
            "TCombobox",
            fieldbackground="#1e293b",
            background="#1e293b",
            foreground="white"
        )

        header = tk.Frame(self.root, bg="#101827")
        header.pack(fill="x", padx=25, pady=(22, 10))

        tk.Label(
            header, text="PIXELBATCH",
            font=("Segoe UI", 25, "bold"),
            fg="#38bdf8", bg="#101827"
        ).pack(anchor="w")

        tk.Label(
            header,
            text="BULK IMAGE RESIZER  •  CONVERTER  •  WATERMARK TOOL",
            font=("Segoe UI", 9),
            fg="#94a3b8", bg="#101827"
        ).pack(anchor="w", pady=(3, 0))

        body = tk.Frame(self.root, bg="#172235")
        body.pack(fill="both", expand=True, padx=25, pady=10)

        toolbar = tk.Frame(body, bg="#172235")
        toolbar.pack(fill="x", padx=16, pady=15)

        self.make_button(
            toolbar, "＋ Add Images", self.add_images, "#0284c7"
        ).pack(side="left", padx=(0, 8))

        self.make_button(
            toolbar, "Clear List", self.clear_list, "#334155"
        ).pack(side="left")

        self.count_label = tk.Label(
            toolbar, text="0 images selected",
            bg="#172235", fg="#cbd5e1",
            font=("Segoe UI", 10)
        )
        self.count_label.pack(side="right")

        list_frame = tk.Frame(body, bg="#172235")
        list_frame.pack(fill="both", expand=True, padx=16)

        self.listbox = tk.Listbox(
            list_frame,
            bg="#0f172a", fg="#e2e8f0",
            selectbackground="#0369a1",
            font=("Segoe UI", 10),
            relief="flat", borderwidth=0,
            height=8
        )
        scrollbar = ttk.Scrollbar(
            list_frame, orient="vertical",
            command=self.listbox.yview
        )
        self.listbox.configure(yscrollcommand=scrollbar.set)
        self.listbox.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        settings = tk.Frame(body, bg="#172235")
        settings.pack(fill="x", padx=16, pady=15)

        self.section_title(settings, "OUTPUT SETTINGS").grid(
            row=0, column=0, columnspan=4,
            sticky="w", pady=(0, 12)
        )

        self.add_label(settings, "Width (px)", 1, 0)
        tk.Entry(
            settings, textvariable=self.width_var,
            width=12, bg="#0f172a", fg="white",
            insertbackground="white", relief="flat"
        ).grid(row=2, column=0, sticky="w", ipady=7, padx=(0, 12))

        self.add_label(settings, "Height (px)", 1, 1)
        tk.Entry(
            settings, textvariable=self.height_var,
            width=12, bg="#0f172a", fg="white",
            insertbackground="white", relief="flat"
        ).grid(row=2, column=1, sticky="w", ipady=7, padx=(0, 12))

        self.add_label(settings, "Format", 1, 2)
        ttk.Combobox(
            settings, textvariable=self.format_var,
            values=["JPEG", "PNG", "WEBP"],
            state="readonly", width=12
        ).grid(row=2, column=2, sticky="w", ipady=4, padx=(0, 12))

        self.add_label(settings, "Quality", 1, 3)
        tk.Spinbox(
            settings, from_=10, to=100,
            textvariable=self.quality_var,
            width=8, bg="#0f172a", fg="white",
            buttonbackground="#334155",
            insertbackground="white", relief="flat"
        ).grid(row=2, column=3, sticky="w", ipady=5)

        tk.Checkbutton(
            settings, text="Keep original aspect ratio",
            variable=self.keep_ratio_var,
            bg="#172235", fg="#e2e8f0",
            selectcolor="#0f172a", activebackground="#172235",
            activeforeground="white"
        ).grid(row=3, column=0, columnspan=2, sticky="w", pady=12)

        self.add_label(settings, "Optional text watermark", 4, 0)
        tk.Entry(
            settings, textvariable=self.watermark_var,
            bg="#0f172a", fg="white",
            insertbackground="white", relief="flat"
        ).grid(
            row=5, column=0, columnspan=4,
            sticky="ew", ipady=8, pady=(0, 12)
        )

        settings.columnconfigure(0, weight=1)
        settings.columnconfigure(1, weight=1)
        settings.columnconfigure(2, weight=1)
        settings.columnconfigure(3, weight=1)

        footer = tk.Frame(self.root, bg="#101827")
        footer.pack(fill="x", padx=25, pady=(0, 20))

        self.progress = ttk.Progressbar(
            footer, mode="determinate", maximum=100
        )
        self.progress.pack(fill="x", pady=(0, 10))

        tk.Label(
            footer, textvariable=self.status_var,
            bg="#101827", fg="#cbd5e1",
            font=("Segoe UI", 9)
        ).pack(anchor="w", pady=(0, 8))

        self.make_button(
            footer, "Choose Output Folder",
            self.choose_output, "#334155"
        ).pack(side="left")

        self.make_button(
            footer, "PROCESS IMAGES",
            self.start_processing, "#059669"
        ).pack(side="right")

    def section_title(self, parent, text):
        return tk.Label(
            parent, text=text,
            font=("Segoe UI", 10, "bold"),
            bg="#172235", fg="#38bdf8"
        )

    def add_label(self, parent, text, row, col):
        tk.Label(
            parent, text=text,
            bg="#172235", fg="#cbd5e1",
            font=("Segoe UI", 9)
        ).grid(row=row, column=col, sticky="w", pady=(0, 5))

    def make_button(self, parent, text, command, color):
        return tk.Button(
            parent, text=text, command=command,
            bg=color, fg="white",
            activebackground=color, activeforeground="white",
            font=("Segoe UI", 10, "bold"),
            relief="flat", cursor="hand2",
            padx=14, pady=9
        )

    def add_images(self):
        paths = filedialog.askopenfilenames(
            title="Select images",
            filetypes=[
                ("Image files", "*.png *.jpg *.jpeg *.webp *.bmp *.tif *.tiff"),
                ("All files", "*.*")
            ]
        )
        existing = set(self.files)

        for path in paths:
            if path not in existing:
                self.files.append(path)
                existing.add(path)

        self.refresh_list()

    def refresh_list(self):
        self.listbox.delete(0, tk.END)
        for path in self.files:
            self.listbox.insert(tk.END, os.path.basename(path))

        self.count_label.config(
            text=f"{len(self.files)} images selected"
        )

    def clear_list(self):
        self.files.clear()
        self.refresh_list()
        self.progress["value"] = 0
        self.status_var.set("Image list cleared")

    def choose_output(self):
        folder = filedialog.askdirectory(title="Choose output folder")
        if folder:
            self.output_folder = folder
            self.status_var.set("Output: " + folder)

    def start_processing(self):
        if not self.files:
            messagebox.showwarning(
                "No images", "Please add at least one image."
            )
            return

        try:
            width = int(self.width_var.get())
            height = int(self.height_var.get())
            quality = int(self.quality_var.get())

            if width < 1 or height < 1:
                raise ValueError("Width and height must be positive.")
            if not 10 <= quality <= 100:
                raise ValueError("Quality must be between 10 and 100.")

        except (ValueError, tk.TclError) as error:
            messagebox.showerror("Invalid settings", str(error))
            return

        os.makedirs(self.output_folder, exist_ok=True)
        self.progress["value"] = 0
        self.status_var.set("Processing images...")
        threading.Thread(
            target=self.process_images,
            args=(width, height, quality),
            daemon=True
        ).start()

    def process_images(self, width, height, quality):
        total = len(self.files)
        success = 0
        errors = []

        for index, path in enumerate(self.files, start=1):
            try:
                with Image.open(path) as original:
                    image = ImageOps.exif_transpose(original)
                    image.load()

                    if self.keep_ratio_var.get():
                        image.thumbnail((width, height), Image.Resampling.LANCZOS)
                    else:
                        image = image.resize(
                            (width, height), Image.Resampling.LANCZOS
                        )

                    watermark = self.watermark_var.get().strip()
                    if watermark:
                        if image.mode not in ("RGB", "RGBA"):
                            image = image.convert("RGBA")

                        overlay = Image.new("RGBA", image.size, (0, 0, 0, 0))
                        draw = ImageDraw.Draw(overlay)
                        font = ImageFont.load_default()
                        padding = max(10, image.width // 50)

                        draw.text(
                            (image.width - padding, image.height - padding),
                            watermark,
                            fill=(255, 255, 255, 210),
                            font=font, anchor="rb",
                            stroke_width=1, stroke_fill=(0, 0, 0, 180)
                        )
                        image = Image.alpha_composite(
                            image.convert("RGBA"), overlay
                        )

                    fmt = self.format_var.get()
                    name = os.path.splitext(os.path.basename(path))[0]
                    extension = {"JPEG": ".jpg", "PNG": ".png", "WEBP": ".webp"}[fmt]
                    output_path = os.path.join(
                        self.output_folder, name + "_processed" + extension
                    )

                    if fmt == "JPEG":
                        if image.mode not in ("RGB", "L"):
                            background = Image.new("RGB", image.size, "white")
                            if image.mode == "RGBA":
                                background.paste(image, mask=image.getchannel("A"))
                            else:
                                background.paste(image.convert("RGB"))
                            image = background
                        image.save(output_path, "JPEG", quality=quality, optimize=True)
                    elif fmt == "WEBP":
                        image.save(output_path, "WEBP", quality=quality, method=6)
                    else:
                        image.save(output_path, "PNG", optimize=True)

                    success += 1

            except Exception as error:
                errors.append(f"{os.path.basename(path)}: {error}")

            percent = int(index / total * 100)
            self.root.after(0, self.update_progress, percent, index, total)

        self.root.after(
            0, self.processing_finished, success, errors
        )

    def update_progress(self, percent, current, total):
        self.progress["value"] = percent
        self.status_var.set(f"Processing {current}/{total} images...")

    def processing_finished(self, success, errors):
        self.status_var.set(
            f"Finished: {success} successful, {len(errors)} failed."
        )

        if errors:
            details = "\n".join(errors[:8])
            if len(errors) > 8:
                details += f"\n...and {len(errors) - 8} more errors."
            messagebox.showwarning(
                "Processing finished",
                f"Successful: {success}\nFailed: {len(errors)}\n\n{details}"
            )
        else:
            messagebox.showinfo(
                "Success",
                f"Processed {success} images successfully!\n\n"
                f"Saved in:\n{self.output_folder}"
            )


if __name__ == "__main__":
    root = tk.Tk()
    app = PixelBatch(root)
    root.mainloop()
