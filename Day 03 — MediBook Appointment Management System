            self.doctor_tree.insert(
                "",
                "end",
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    row[4],
                    row[5]
                )
            )

    def open_doctor_form(self, doctor_id=None):
        win = tk.Toplevel(self)

        win.title(
            "Edit Doctor"
            if doctor_id
            else "Add Doctor"
        )

        win.geometry("500x620")
        win.resizable(False, False)
        win.configure(bg=WHITE)
        win.transient(self)
        win.grab_set()

        tk.Label(
            win,
            text=(
                "Edit Doctor"
                if doctor_id
                else "Add New Doctor"
            ),
            bg=WHITE,
            fg=TEXT,
            font=("Segoe UI", 20, "bold")
        ).pack(
            anchor="w",
            padx=28,
            pady=(25, 15)
        )

        form = tk.Frame(
            win,
            bg=WHITE
        )
        form.pack(
            fill="both",
            expand=True,
            padx=28
        )

        name_var = tk.StringVar()
        specialty_var = tk.StringVar()
        phone_var = tk.StringVar()
        email_var = tk.StringVar()
        availability_var = tk.StringVar(
            value="Mon - Sat, 10:00 - 17:00"
        )

        fields = [
            ("Doctor Name", name_var),
            ("Specialty", specialty_var),
            ("Phone Number", phone_var),
            ("Email Address", email_var),
            ("Availability", availability_var)
        ]

        for label, variable in fields:
            self.input_label(
                form,
                label
            )

            tk.Entry(
                form,
                textvariable=variable,
                bg="#F8FAFC",
                relief="flat",
                font=("Segoe UI", 10)
            ).pack(
                fill="x",
                ipady=9
            )

        if doctor_id:
            data = self.db.get_doctor_by_id(
                doctor_id
            )

            if data:
                name_var.set(data[1])
                specialty_var.set(data[2])
                phone_var.set(data[3] or "")
                email_var.set(data[4] or "")
                availability_var.set(data[5] or "")

        def save():
            name = name_var.get().strip()
            specialty = specialty_var.get().strip()

            if not name or not specialty:
                messagebox.showwarning(
                    "Missing Data",
                    "Doctor name and specialty are required."
                )
                return

            if doctor_id:
                self.db.update_doctor(
                    doctor_id,
                    name,
                    specialty,
                    phone_var.get().strip(),
                    email_var.get().strip(),
                    availability_var.get().strip()
                )
            else:
                self.db.add_doctor(
                    name,
                    specialty,
                    phone_var.get().strip(),
                    email_var.get().strip(),
                    availability_var.get().strip()
                )

            win.destroy()
            self.show_doctors()

        tk.Button(
            win,
            text=(
                "Update Doctor"
                if doctor_id
                else "Add Doctor"
            ),
            bg=PRIMARY,
            fg=WHITE,
            bd=0,
            pady=12,
            font=("Segoe UI", 10, "bold"),
            command=save
        ).pack(
            fill="x",
            padx=28,
            pady=24
        )

    def edit_selected_doctor(self):
        selected = self.doctor_tree.selection()

        if not selected:
            messagebox.showwarning(
                "Select Doctor",
                "Please select a doctor."
            )
            return

        values = self.doctor_tree.item(
            selected[0],
            "values"
        )

        self.open_doctor_form(
            int(values[0])
        )

    def delete_selected_doctor(self):
        selected = self.doctor_tree.selection()

        if not selected:
            messagebox.showwarning(
                "Select Doctor",
                "Please select a doctor."
            )
            return

        values = self.doctor_tree.item(
            selected[0],
            "values"
        )

        if messagebox.askyesno(
            "Delete Doctor",
            "Deleting this doctor will also remove their appointments.\nContinue?"
        ):
            self.db.delete_doctor(
                int(values[0])
            )
            self.load_doctors()

