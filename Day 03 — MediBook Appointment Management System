            messagebox.showwarning(
                "Doctors Required",
                "Please add at least one doctor first."
            )
            return

        win = tk.Toplevel(self)
        win.title(
            "Edit Appointment"
            if appointment_id
            else "New Appointment"
        )
        win.geometry("550x690")
        win.resizable(False, False)
        win.configure(bg=WHITE)
        win.transient(self)
        win.grab_set()

        title = (
            "Edit Appointment"
            if appointment_id
            else "Schedule New Appointment"
        )

        tk.Label(
            win,
            text=title,
            bg=WHITE,
            fg=TEXT,
            font=("Segoe UI", 20, "bold")
        ).pack(
            anchor="w",
            padx=28,
            pady=(25, 5)
        )

        tk.Label(
            win,
            text="Enter appointment details below.",
            bg=WHITE,
            fg=MUTED,
            font=("Segoe UI", 9)
        ).pack(
            anchor="w",
            padx=28,
            pady=(0, 15)
        )

        form = tk.Frame(
            win,
            bg=WHITE
        )
        form.pack(
            fill="both",
            expand=True,
            padx=28
        )

        patient_map = {
            f"{p[0]} - {p[1]}": p[0]
            for p in patients
        }

        doctor_map = {
            f"{d[0]} - {d[1]} ({d[2]})": d[0]
            for d in doctors
        }

        self.input_label(form, "Patient")
        patient_var = tk.StringVar()

        patient_combo = ttk.Combobox(
            form,
            textvariable=patient_var,
            values=list(patient_map.keys()),
            state="readonly"
        )
        patient_combo.pack(
            fill="x",
            ipady=4
        )

        self.input_label(form, "Doctor")
        doctor_var = tk.StringVar()

        doctor_combo = ttk.Combobox(
            form,
            textvariable=doctor_var,
            values=list(doctor_map.keys()),
            state="readonly"
        )
        doctor_combo.pack(
            fill="x",
            ipady=4
        )

        self.input_label(
            form,
            "Appointment Date (YYYY-MM-DD)"
        )

        date_var = tk.StringVar(
            value=date.today().strftime("%Y-%m-%d")
        )

        date_entry = tk.Entry(
            form,
            textvariable=date_var,
            bg="#F8FAFC",
            relief="flat",
            font=("Segoe UI", 10)
        )
        date_entry.pack(
            fill="x",
            ipady=9
        )

        self.input_label(
            form,
            "Appointment Time (HH:MM)"
        )

        time_var = tk.StringVar(
            value="10:00"
        )

        time_entry = tk.Entry(
            form,
            textvariable=time_var,
            bg="#F8FAFC",
            relief="flat",
            font=("Segoe UI", 10)
        )
        time_entry.pack(
            fill="x",
            ipady=9
        )

        self.input_label(form, "Status")

        status_var = tk.StringVar(
            value="Scheduled"
        )

        status_combo = ttk.Combobox(
            form,
            textvariable=status_var,
            values=[
                "Scheduled",
                "Completed",
                "Cancelled"
            ],
            state="readonly"
        )
        status_combo.pack(
            fill="x",
            ipady=4
        )

        self.input_label(form, "Reason")

        reason_var = tk.StringVar()

        reason_entry = tk.Entry(
            form,
            textvariable=reason_var,
            bg="#F8FAFC",
            relief="flat",
            font=("Segoe UI", 10)
        )
        reason_entry.pack(
            fill="x",
            ipady=9
        )

        self.input_label(form, "Notes")

        notes_text = tk.Text(
            form,
            height=5,
            bg="#F8FAFC",
            fg=TEXT,
            relief="flat",
            font=("Segoe UI", 10)
        )
        notes_text.pack(
            fill="x"
        )

        if appointment_id:
            data = self.db.get_appointment_by_id(
                appointment_id
            )

            if data:
                patient_id = data[1]
                doctor_id = data[2]

                for label, pid in patient_map.items():
                    if pid == patient_id:
                        patient_var.set(label)
                        break

                for label, did in doctor_map.items():
                    if did == doctor_id:
                        doctor_var.set(label)
                        break

                date_var.set(data[3])
                time_var.set(data[4])
                status_var.set(data[5])
                reason_var.set(data[6] or "")

                notes_text.insert(
                    "1.0",
                    data[7] or ""
                )

        def save():
            patient_label = patient_var.get()
            doctor_label = doctor_var.get()

            if not patient_label or not doctor_label:
                messagebox.showwarning(
                    "Missing Data",
                    "Please select patient and doctor."
                )
                return

            appointment_date = date_var.get().strip()
            appointment_time = time_var.get().strip()

            try:
                datetime.strptime(
                    appointment_date,
                    "%Y-%m-%d"
                )

                datetime.strptime(
                    appointment_time,
                    "%H:%M"
                )

            except ValueError:
                messagebox.showerror(
                    "Invalid Date/Time",
                    "Use date YYYY-MM-DD and time HH:MM."
                )
                return

            patient_id = patient_map[patient_label]
            doctor_id = doctor_map[doctor_label]

            reason = reason_var.get().strip()
            notes = notes_text.get(
                "1.0",
                "end"
            ).strip()

            if appointment_id:
                self.db.update_appointment(
                    appointment_id,
                    patient_id,
                    doctor_id,
                    appointment_date,
                    appointment_time,
                    status_var.get(),
                    reason,
                    notes
                )
            else:
                self.db.add_appointment(
                    patient_id,
                    doctor_id,
                    appointment_date,
                    appointment_time,
                    status_var.get(),
                    reason,
                    notes
                )

            win.destroy()
            self.show_appointments()

        tk.Button(
            win,
            text=(
                "Update Appointment"
                if appointment_id
                else "Schedule Appointment"
            ),
            bg=PRIMARY,
            fg=WHITE,
            activebackground=PRIMARY_DARK,
            activeforeground=WHITE,
            bd=0,
            relief="flat",
            font=("Segoe UI", 10, "bold"),
            pady=12,
            command=save
        ).pack(
            fill="x",
            padx=28,
            pady=24
        )

