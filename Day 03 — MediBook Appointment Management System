    def animate_number(self, label, target, current=0):
        if target <= 0:
            label.configure(text="0")
            return

        step = max(1, target // 20)
        current += step

        if current >= target:
            label.configure(text=str(target))
            return

        label.configure(text=str(current))
        self.after(
            25,
            lambda: self.animate_number(
                label,
                target,
                current
            )
        )

    def animate_bar(self, bar, container, ratio, step=0):
        if step > 20:
            return

        self.update_idletasks()

        total_width = container.winfo_width()

        width = int(
            total_width * ratio * (step / 20)
        )

        bar.configure(width=width)

        self.after(
            15,
            lambda: self.animate_bar(
                bar,
                container,
                ratio,
                step + 1
            )
        )

