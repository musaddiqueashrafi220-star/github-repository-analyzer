# DATABASE
# ============================================================

class Database:
    def __init__(self):
        self.conn = sqlite3.connect(DB_FILE)
        self.cursor = self.conn.cursor()
        self.create_tables()

    def create_tables(self):
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS patients (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                phone TEXT NOT NULL,
                email TEXT,
                gender TEXT,
                age INTEGER,
                address TEXT,
                created_at TEXT
            )
        """)

        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS doctors (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                specialty TEXT NOT NULL,
                phone TEXT,
                email TEXT,
                availability TEXT,
                created_at TEXT
            )
        """)

        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS appointments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                patient_id INTEGER NOT NULL,
                doctor_id INTEGER NOT NULL,
                appointment_date TEXT NOT NULL,
                appointment_time TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'Scheduled',
                reason TEXT,
                notes TEXT,
                created_at TEXT,
                FOREIGN KEY(patient_id) REFERENCES patients(id),
                FOREIGN KEY(doctor_id) REFERENCES doctors(id)
            )
        """)

        self.conn.commit()

    # ---------------- Patients ----------------

    def add_patient(self, name, phone, email, gender, age, address):
        self.cursor.execute("""
            INSERT INTO patients
            (name, phone, email, gender, age, address, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            name,
            phone,
            email,
            gender,
            age,
            address,
            datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        ))
        self.conn.commit()

    def get_patients(self, search=""):
        if search:
            query = """
                SELECT * FROM patients
                WHERE name LIKE ?
                OR phone LIKE ?
                OR email LIKE ?
                ORDER BY id DESC
            """
            val = f"%{search}%"
            return self.cursor.execute(query, (val, val, val)).fetchall()

        return self.cursor.execute(
            "SELECT * FROM patients ORDER BY id DESC"
        ).fetchall()

    def get_patient_by_id(self, patient_id):
        return self.cursor.execute(
            "SELECT * FROM patients WHERE id=?",
            (patient_id,)
        ).fetchone()

    def update_patient(self, patient_id, name, phone, email, gender, age, address):
        self.cursor.execute("""
            UPDATE patients
            SET name=?, phone=?, email=?, gender=?, age=?, address=?
            WHERE id=?
        """, (
            name,
            phone,
            email,
            gender,
            age,
            address,
            patient_id
        ))
        self.conn.commit()

    def delete_patient(self, patient_id):
        self.cursor.execute(
            "DELETE FROM appointments WHERE patient_id=?",
            (patient_id,)
        )
        self.cursor.execute(
            "DELETE FROM patients WHERE id=?",
            (patient_id,)
        )
        self.conn.commit()

    # ---------------- Doctors ----------------

    def add_doctor(self, name, specialty, phone, email, availability):
        self.cursor.execute("""
            INSERT INTO doctors
            (name, specialty, phone, email, availability, created_at)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (
            name,
            specialty,
            phone,
            email,
            availability,
            datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        ))
        self.conn.commit()

    def get_doctors(self, search=""):
        if search:
            val = f"%{search}%"
            return self.cursor.execute("""
                SELECT * FROM doctors
                WHERE name LIKE ?
                OR specialty LIKE ?
                OR phone LIKE ?
                ORDER BY id DESC
            """, (val, val, val)).fetchall()

        return self.cursor.execute(
            "SELECT * FROM doctors ORDER BY id DESC"
        ).fetchall()

    def get_doctor_by_id(self, doctor_id):
        return self.cursor.execute(
            "SELECT * FROM doctors WHERE id=?",
            (doctor_id,)
        ).fetchone()

    def update_doctor(self, doctor_id, name, specialty, phone, email, availability):
        self.cursor.execute("""
            UPDATE doctors
            SET name=?, specialty=?, phone=?, email=?, availability=?
            WHERE id=?
        """, (
            name,
            specialty,
            phone,
            email,
            availability,
            doctor_id
        ))
        self.conn.commit()

    def delete_doctor(self, doctor_id):
        self.cursor.execute(
            "DELETE FROM appointments WHERE doctor_id=?",
            (doctor_id,)
        )
        self.cursor.execute(
            "DELETE FROM doctors WHERE id=?",
            (doctor_id,)
        )
        self.conn.commit()

    # ---------------- Appointments ----------------

    def add_appointment(
        self,
        patient_id,
        doctor_id,
        appointment_date,
        appointment_time,
        status,
        reason,
        notes
    ):
        self.cursor.execute("""
            INSERT INTO appointments
            (
                patient_id,
                doctor_id,
                appointment_date,
                appointment_time,
                status,
                reason,
                notes,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            patient_id,
            doctor_id,
            appointment_date,
            appointment_time,
            status,
            reason,
            notes,
            datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        ))
        self.conn.commit()

    def get_appointments(self, search="", status="All"):
        query = """
            SELECT
                a.id,
                p.name,
                d.name,
                d.specialty,
                a.appointment_date,
                a.appointment_time,
                a.status,
                a.reason,
                a.notes,
                a.patient_id,
                a.doctor_id
            FROM appointments a
            JOIN patients p ON a.patient_id = p.id
            JOIN doctors d ON a.doctor_id = d.id
            WHERE 1=1
        """

        params = []

        if search:
            query += """
                AND (
                    p.name LIKE ?
                    OR d.name LIKE ?
                    OR d.specialty LIKE ?
                    OR a.reason LIKE ?
                )
            """
            val = f"%{search}%"
            params.extend([val, val, val, val])

        if status != "All":
            query += " AND a.status=?"
            params.append(status)

        query += """
            ORDER BY
                a.appointment_date ASC,
                a.appointment_time ASC
        """

        return self.cursor.execute(query, params).fetchall()

    def get_appointment_by_id(self, appointment_id):
        return self.cursor.execute("""
            SELECT *
            FROM appointments
            WHERE id=?
        """, (appointment_id,)).fetchone()

    def update_appointment(
        self,
        appointment_id,
        patient_id,
        doctor_id,
        appointment_date,
        appointment_time,
        status,
        reason,
        notes
    ):
        self.cursor.execute("""
            UPDATE appointments
            SET patient_id=?,
                doctor_id=?,
                appointment_date=?,
                appointment_time=?,
                status=?,
                reason=?,
                notes=?
            WHERE id=?
        """, (
            patient_id,
            doctor_id,
            appointment_date,
            appointment_time,
            status,
            reason,
            notes,
            appointment_id
        ))
        self.conn.commit()

    def delete_appointment(self, appointment_id):
        self.cursor.execute(
            "DELETE FROM appointments WHERE id=?",
            (appointment_id,)
        )
        self.conn.commit()

    # ---------------- Dashboard ----------------

    def get_dashboard_stats(self):
        today = date.today().strftime("%Y-%m-%d")

        total_patients = self.cursor.execute(
            "SELECT COUNT(*) FROM patients"
        ).fetchone()[0]

        total_doctors = self.cursor.execute(
            "SELECT COUNT(*) FROM doctors"
        ).fetchone()[0]

        today_appointments = self.cursor.execute(
            "SELECT COUNT(*) FROM appointments WHERE appointment_date=?",
            (today,)
        ).fetchone()[0]

        completed = self.cursor.execute("""
            SELECT COUNT(*)
            FROM appointments
            WHERE status='Completed'
        """).fetchone()[0]

        return {
            "patients": total_patients,
            "doctors": total_doctors,
            "today": today_appointments,
            "completed": completed
        }

    def get_today_appointments(self):
        today = date.today().strftime("%Y-%m-%d")

        return self.cursor.execute("""
            SELECT
                a.id,
                p.name,
                d.name,
                d.specialty,
                a.appointment_time,
                a.status
            FROM appointments a
            JOIN patients p ON a.patient_id=p.id
            JOIN doctors d ON a.doctor_id=d.id
            WHERE a.appointment_date=?
            ORDER BY a.appointment_time ASC
        """, (today,)).fetchall()

    def get_status_counts(self):
        statuses = ["Scheduled", "Completed", "Cancelled"]

        data = {}

        for status in statuses:
            count = self.cursor.execute("""
                SELECT COUNT(*)
                FROM appointments
                WHERE status=?
            """, (status,)).fetchone()[0]

            data[status] = count

        return data

    def close(self):
        self.conn.close()


