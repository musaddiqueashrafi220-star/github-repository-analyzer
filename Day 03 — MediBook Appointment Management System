            )

        report_tree.pack(
            fill="both",
            expand=True,
            padx=18,
            pady=(0, 18)
        )

        rows = self.db.get_appointments()

        for row in rows:
            report_tree.insert(
                "",
                "end",
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    row[4],
                    row[5],
                    row[6],
                    row[7]
                )
            )

    def export_csv(self):
        rows = self.db.get_appointments()

        if not rows:
            messagebox.showinfo(
                "No Data",
                "No appointment records available."
            )
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".csv",
            filetypes=[
                ("CSV Files", "*.csv")
            ],
            initialfile="appointment_report.csv"
        )

        if not path:
            return

        with open(
            path,
            "w",
            newline="",
            encoding="utf-8"
        ) as file:
            writer = csv.writer(file)

            writer.writerow([
                "ID",
                "Patient",
                "Doctor",
                "Specialty",
                "Date",
                "Time",
                "Status",
                "Reason",
                "Notes"
            ])

            for row in rows:
                writer.writerow([
                    row[0],
                    row[1],
                    row[2],
                    row[3],
                    row[4],
                    row[5],
                    row[6],
                    row[7],
                    row[8]
                ])

        messagebox.showinfo(
            "Export Successful",
            "Appointment report exported successfully."
        )

